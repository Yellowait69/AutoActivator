<UserControl x:Class="AutoActivator.Gui.Views.ExtractionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />
        <SolidColorBrush x:Key="BorderDefault" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SurfaceMuted" Color="#F8FAFC" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#16A34A" />
        <SolidColorBrush x:Key="DangerRed" Color="#DC2626" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- EN-TÊTE COMPACT (IDENTIQUE À ACTIVATION) -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Extraction Contrats"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCompareLatestExt"
                            Content="📊 Comparer"
                            Click="BtnCompareLatestExt_Click"
                            Background="#F5F3FF"
                            Foreground="#6D28D9"
                            BorderBrush="#DDD6FE"
                            BorderThickness="1"
                            Padding="12,5"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            FontWeight="Bold" />
                    <Button x:Name="BtnAddBaselineExt"
                            Content="➕ Baseline"
                            Click="BtnAddBaseline_Click"
                            Background="#EFF6FF"
                            Foreground="#1D4ED8"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            Padding="12,5"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            FontWeight="Bold" />
                    <Button x:Name="BtnOpenBaselineExt"
                            Content="📂 Baselines"
                            Click="BtnOpenBaselineFolder_Click"
                            Background="#F8FAFC"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Padding="12,5"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            FontWeight="Bold" />
                    <Button Content="❓ Help"
                            Background="#EFF6FF"
                            Foreground="#2563EB"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            Padding="12,5"
                            Cursor="Hand"
                            FontWeight="Bold"
                            Click="BtnHelp_Click" />
                </StackPanel>
            </Grid>

            <!-- BANNIÈRE D'ÉTAT HAUTE VISIBILITÉ (VERT = ACTIF, ROUGE = ÉCHEC / NON ACTIF) -->
            <Border x:Name="BannerExtractionResult"
                    Grid.Row="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    BorderThickness="1.5"
                    Background="#DCFCE7"
                    BorderBrush="#4ADE80"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBannerExtTitle"
                                   Text="🟢 EXTRACTION RÉUSSIE"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Foreground="#15803D" />
                        <TextBlock x:Name="TxtBannerExtDetail"
                                   Text=""
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#166534"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="BtnInspectBannerExt"
                            Grid.Column="1"
                            Content="🔍 Voir le rapport"
                            Click="BtnInspectSelectedExt_Click"
                            Padding="10,5"
                            Margin="12,0,0,0"
                            FontWeight="Bold"
                            Background="White"
                            Foreground="#0F172A"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Hand"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- CARTE UNIQUE : CONFIGURATION + EXÉCUTION UNITAIRE & BATCH (IDENTIQUE À ACTIVATION) -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <!-- LIGNE 1 : CONFIGURATION RAPIDE -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Environnement :" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="CmbExtEnv"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbExtEnv_SelectionChanged">
                                <ComboBoxItem Content="D000 - Development (IM7T)" Tag="D" />
                                <ComboBoxItem Content="Q000 - Qualification (IM7C)" Tag="Q" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Process :" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="CmbExtChannel"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbExtChannel_SelectionChanged">
                                <ComboBoxItem Content="C01 - Standard Life / UL" Tag="C01" />
                                <ComboBoxItem Content="C02 - Bank Standard" Tag="C02" />
                                <ComboBoxItem Content="C03 - Classic / Pension" Tag="C03" />
                                <ComboBoxItem Content="C05 - Direct IMS / No Billing" Tag="C05" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- LIGNE 2 : EXTRACTION UNITAIRE -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⚡ Contrat / Demand ID :"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TxtExtContract"
                                 Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 FontSize="13.5"
                                 FontWeight="SemiBold"
                                 KeyDown="TxtExtContract_KeyDown"
                                 ToolTip="Numéro de Contrat (582-...) ou Demand ID ELIA" />
                        <Button x:Name="BtnRunSingle"
                                Grid.Column="2"
                                Content="🚀 Extraire"
                                Click="BtnRunSingle_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                Width="135" />
                    </Grid>

                    <!-- LIGNE 3 : EXTRACTION BATCH (EXCEL / CSV) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="📁 Fichier Batch Excel :"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TxtBatchExtCsv"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Background="#F8FAFC"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="2"
                                Content="📂 Parcourir"
                                Padding="10,6"
                                Margin="0,0,6,0"
                                Background="#334155"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnBrowseExtCsv_Click" />
                        <Button x:Name="BtnUseDefaultQcExtFile"
                                Grid.Column="3"
                                Content="📋 Default QC"
                                Padding="10,6"
                                Margin="0,0,6,0"
                                Background="#0F766E"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnUseDefaultQcExtFile_Click" />
                        <Button x:Name="BtnRunBatch"
                                Grid.Column="4"
                                Content="🚀 Lancer Batch"
                                Click="BtnRunBatch_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                Width="135" />
                    </Grid>

                    <!-- BOUTON STOP EN DESSOUS DES DEUX LIGNES -->
                    <Button x:Name="BtnCancelSingleExt"
                            Content="🛑 Stop"
                            Click="BtnCancelExtraction_Click"
                            Style="{DynamicResource CancelButtonStyle}"
                            HorizontalAlignment="Right"
                            Width="135"
                            Margin="0,0,0,8"
                            IsEnabled="False" />

                    <!-- BARRE DE PROGRESSION COMPACTE -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center">
                                    <Run x:Name="TxtExtBatchCurrentContract" Text="Prêt" Foreground="#1E293B" FontWeight="SemiBold" />
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtExtBatchProcessedCount" Text="0" FontWeight="Bold" Foreground="#15803D" FontSize="12" />
                                    <TextBlock Text="/" Foreground="#64748B" FontSize="12" Margin="2,0" />
                                    <TextBlock x:Name="TxtExtBatchPlannedCount" Text="0" FontWeight="Bold" Foreground="#0F172A" FontSize="12" />
                                    <TextBlock x:Name="TxtExtElapsedTime" Text="  ⏱️ 0.0s" FontWeight="SemiBold" Foreground="#475569" FontSize="11.5" Margin="6,0,8,0" />
                                    <TextBlock x:Name="TxtExtBatchProgressPercentage" Text="0%" FontWeight="Bold" FontSize="12.5" Foreground="#2563EB" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="ProgressBatchExtraction"
                                         Grid.Row="1"
                                         Height="6"
                                         Margin="0,4,0,0"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="0"
                                         Foreground="#2563EB"
                                         Background="#E2E8F0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- TABLEAU DES RÉSULTATS (ÉCHECS ROUGES EN HAUT, SUCCÈS/DÉJÀ ACTIFS EN VERT) -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BARRE COMPTEURS (3 BADGES) + FILTRE + 2 BOUTONS -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BadgeExtAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total : " FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                                </StackPanel>
                            </Border>
                            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BadgeExtGreen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟢 Actifs / Déjà actifs : " FontSize="12" FontWeight="SemiBold" Foreground="#15803D" />
                                    <TextBlock x:Name="TxtOkCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#15803D" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,12,0" Cursor="Hand" MouseLeftButtonDown="BadgeExtFailed_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔴 Échecs : " FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" />
                                    <TextBlock x:Name="TxtKoCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFilterExtHistory"
                                     Grid.Column="0"
                                     Padding="8,4"
                                     FontSize="12"
                                     BorderBrush="#CBD5E1"
                                     ToolTip="Rechercher par Contrat, Demand ID, Produit, LISA ID ou Canal"
                                     TextChanged="FilterExtHistory_Changed" />
                            <ComboBox x:Name="CmbFilterExtStatus"
                                      Grid.Column="2"
                                      Padding="8,4"
                                      FontSize="12"
                                      SelectedIndex="0"
                                      SelectionChanged="FilterExtHistory_Changed">
                                <ComboBoxItem Content="Tous les statuts" Tag="ALL" />
                                <ComboBoxItem Content="🟢 Actifs / Déjà actifs" Tag="OK" />
                                <ComboBoxItem Content="🔴 Échecs uniquement" Tag="KO_OR_ELIA" />
                            </ComboBox>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnExportExtHistoryCsv"
                                    Content="📥 Export CSV"
                                    Click="BtnExportExtHistoryCsv_Click"
                                    Cursor="Hand"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    FontWeight="Bold"
                                    Background="#EFF6FF"
                                    Foreground="#2563EB"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1" />
                            <Button x:Name="BtnClearHistory"
                                    Content="🗑️ Vider"
                                    Click="BtnClearHistory_Click"
                                    Cursor="Hand"
                                    Padding="10,4"
                                    FontWeight="Bold"
                                    Background="White"
                                    Foreground="{StaticResource DangerRed}"
                                    BorderBrush="{StaticResource DangerRed}"
                                    BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="ListHistory"
                              Grid.Row="1"
                              Background="White"
                              BorderBrush="{StaticResource BorderDefault}"
                              BorderThickness="1"
                              MinHeight="240"
                              MaxHeight="520"
                              MouseDoubleClick="ListHistory_MouseDoubleClick"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔍 Ouvrir le rapport complet (SQL &amp; Métadonnées)" Click="MenuExtInspect_Click" FontWeight="Bold" />
                                <MenuItem Header="🔄 Charger dans l'entrée unitaire" Click="MenuExtLoadSingle_Click" FontWeight="SemiBold" />
                                <Separator />
                                <MenuItem Header="📋 Copier le N° de Contrat" Click="MenuExtCopyContract_Click" />
                                <MenuItem Header="📋 Copier le Demand ID" Click="MenuExtCopyDemand_Click" />
                                <MenuItem Header="📂 Ouvrir le fichier CSV extrait" Click="MenuExtOpenCsv_Click" />
                                <Separator />
                                <MenuItem Header="⚡ Envoyer vers Activation Contrats" Click="MenuExtSendToActivation_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="#F0FDF4" />
                                <Setter Property="BorderBrush" Value="#BBF7D0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <!-- 1. STATUT (VERT OU ROUGE) -->
                                <GridViewColumn Header="Statut" Width="125">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="StatusBadge"
                                                    Background="#DCFCE7"
                                                    BorderBrush="#86EFAC"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock x:Name="StatusText"
                                                           Text="{Binding StatusBadgeText}"
                                                           FontWeight="Bold"
                                                           FontSize="11.5"
                                                           Foreground="#15803D" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2" />
                                                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FCA5A5" />
                                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B91C1C" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 2. ROW EXCEL -->
                                <GridViewColumn Header="Row" DisplayMemberBinding="{Binding RowNum}" Width="56" />

                                <!-- 3. ENV -->
                                <GridViewColumn Header="Env" DisplayMemberBinding="{Binding Env}" Width="54" />

                                <!-- 4. CONTRAT -->
                                <GridViewColumn Header="Contrat" Width="128">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ContractId}" FontWeight="Bold" Foreground="#0F172A" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 5. DEMAND ID -->
                                <GridViewColumn Header="Demand ID" DisplayMemberBinding="{Binding Hdmd}" Width="98" />

                                <!-- 6. LISA ID -->
                                <GridViewColumn Header="LISA ID" DisplayMemberBinding="{Binding InternalId}" Width="82" />

                                <!-- 7. BRANCHE -->
                                <GridViewColumn Header="Branche" Width="92">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="BranchBadge" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="7,1" HorizontalAlignment="Center">
                                                <TextBlock x:Name="BranchText" Text="{Binding BranchDisplay}" FontWeight="Bold" FontSize="11" Foreground="#1D4ED8" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBranch23}" Value="True">
                                                    <Setter TargetName="BranchBadge" Property="Background" Value="#F5F3FF" />
                                                    <Setter TargetName="BranchBadge" Property="BorderBrush" Value="#DDD6FE" />
                                                    <Setter TargetName="BranchText" Property="Foreground" Value="#6D28D9" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 8. PRODUIT / PROCESS -->
                                <GridViewColumn Header="Produit (Proc.)" DisplayMemberBinding="{Binding ProductProcessDisplay}" Width="105" />

                                <!-- 9. CANAL & PAIEMENT -->
                                <GridViewColumn Header="Canal (BUCP/CMD)" DisplayMemberBinding="{Binding ChannelPaymentDisplay}" Width="155" />

                                <!-- 10. PRIME -->
                                <GridViewColumn Header="Prime" DisplayMemberBinding="{Binding Premium}" Width="85" />

                                <!-- 11. RÉSULTAT / ERREUR -->
                                <GridViewColumn Header="Résultat / Erreur" Width="380">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="DiagText"
                                                       Text="{Binding SummaryDisplay}"
                                                       Foreground="#15803D"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SummaryDisplay}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter TargetName="DiagText" Property="Foreground" Value="#B91C1C" />
                                                    <Setter TargetName="DiagText" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
