<UserControl x:Class="AutoActivator.Gui.Views.ExtractionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="820">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderDefault" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PrimaryAction" Color="#2563EB"/>
        <SolidColorBrush x:Key="SecondaryAction" Color="#7C3AED"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerLight" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="DangerBorder" Color="#FCA5A5"/>
        <SolidColorBrush x:Key="Success" Color="#15803D"/>
        <SolidColorBrush x:Key="SuccessLight" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="SuccessBorder" Color="#86EFAC"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#F8FAFC"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. BANNIÈRE DE RÉSULTAT EN HAUT (VERTE SI ACTIF LISA+ELIA / ROUGE SI ELIA ONLY OU KO) -->
            <Border x:Name="BannerExtractionResult"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#DCFCE7"
                    BorderBrush="#86EFAC"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="14,9"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBannerExtIcon"
                               Grid.Column="0"
                               Text="🟢"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBannerExtTitle"
                                   Text="EXTRACTION RÉUSSIE (ACTIF LISA + ELIA)"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#15803D"/>
                        <TextBlock x:Name="TxtBannerExtDetail"
                                   Text="-"
                                   FontSize="12"
                                   Foreground="#166534"
                                   TextWrapping="Wrap"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="BtnSendBannerToAct"
                                Content="⚡ Activer"
                                Click="BtnSendSelectedToAct_Click"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                FontSize="11.5"
                                FontWeight="Bold"
                                Background="White"
                                Foreground="#15803D"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                Cursor="Hand"/>
                        <Button x:Name="BtnInspectBannerExt"
                                Content="🔍 Voir le détail"
                                Click="BtnInspectSelectedExt_Click"
                                Padding="10,4"
                                FontSize="11.5"
                                FontWeight="Bold"
                                Background="White"
                                Foreground="#0F172A"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. EN-TÊTE MINIMALISTE -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Extraction SQL"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCompareLatestExt"
                            Content="📊 Comparer"
                            Click="BtnCompareLatestExt_Click"
                            Background="#F5F3FF"
                            Foreground="#6D28D9"
                            BorderBrush="#DDD6FE"
                            BorderThickness="1"
                            Padding="11,5"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            ToolTip="Comparer le dernier CSV extrait avec une Baseline"/>
                    <Button x:Name="BtnAddBaselineExt"
                            Content="➕ Baseline"
                            Click="BtnAddBaseline_Click"
                            Background="#EFF6FF"
                            Foreground="#1D4ED8"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            Padding="11,5"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            ToolTip="Promouvoir le dernier fichier extrait en Baseline"/>
                    <Button x:Name="BtnOpenBaselineExt"
                            Content="📂 Baselines"
                            Click="BtnOpenBaselineFolder_Click"
                            Background="#F8FAFC"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Padding="11,5"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            ToolTip="Ouvrir le dossier des Baselines"/>
                    <Button Content="❓ Aide"
                            Background="#EFF6FF"
                            Foreground="#2563EB"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            Padding="12,5"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="BtnHelp_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. CARTE UNIQUE : CONFIGURATION + LANCEMENT UNITAIRE & BATCH -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Ligne supérieure : Environnement & Process + Bouton Stop -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Environnement" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CmbExtEnv" Style="{StaticResource InputStyle}" SelectedIndex="0" SelectionChanged="CmbExtEnv_SelectionChanged">
                                <ComboBoxItem Content="D000 — Dev (D)" Tag="D"/>
                                <ComboBoxItem Content="Q000 — Qual (Q)" Tag="Q"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Process / Fichier QC par défaut" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CmbExtChannel" Style="{StaticResource InputStyle}" SelectedIndex="0" SelectionChanged="CmbExtChannel_SelectionChanged">
                                <ComboBoxItem Content="C01 — Standard Life / UL" Tag="C01"/>
                                <ComboBoxItem Content="C02 — Bank Distribution" Tag="C02"/>
                                <ComboBoxItem Content="C03 — Classic / Pension" Tag="C03"/>
                                <ComboBoxItem Content="C05 — Direct IMS" Tag="C05"/>
                            </ComboBox>
                        </StackPanel>

                        <Button x:Name="BtnCancelSingleExt"
                                Grid.Column="4"
                                Content="🛑 Stop"
                                Click="BtnCancelExtraction_Click"
                                Style="{DynamicResource CancelButtonStyle}"
                                Width="95"
                                Height="32"
                                VerticalAlignment="Bottom"
                                IsEnabled="False"/>
                    </Grid>

                    <!-- Ligne 1 : Extraction Unitaire -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Unitaire"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtExtContract"
                                 Grid.Column="1"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,8,0"
                                 FontSize="13.5"
                                 FontWeight="SemiBold"
                                 TextChanged="TxtExtContract_TextChanged"
                                 KeyDown="TxtExtContract_KeyDown"
                                 ToolTip="N° Contrat (12 chiffres / 3-7-2) ou Demand ID ELIA (Entrée pour lancer)"/>
                        <Border Grid.Column="2"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtExtDetectedTypeBadge"
                                       Text="Auto : Contrat / Demand ID"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#1D4ED8"/>
                        </Border>
                        <Button x:Name="BtnRunSingle"
                                Grid.Column="3"
                                Content="🚀 Extraire"
                                Click="BtnRunSingle_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                Width="140"/>
                    </Grid>

                    <!-- Ligne 2 : Extraction Batch Excel / CSV -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Batch Excel"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtBatchExtCsv"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Style="{StaticResource InputStyle}"
                                 Background="#F8FAFC"
                                 Margin="0,0,6,0"
                                 ToolTip="Fichier Excel (.xlsx/.xls) ou CSV"/>
                        <Button x:Name="BtnUseDefaultQcExtFile"
                                Grid.Column="2"
                                Content="📋 QC Défaut"
                                Padding="9,6"
                                Margin="0,0,6,0"
                                Background="#F1F5F9"
                                Foreground="#0F172A"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnUseDefaultQcExtFile_Click"/>
                        <Button Grid.Column="3"
                                Content="📂 Parcourir"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Background="#334155"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnBrowseExtCsv_Click"/>
                        <Button x:Name="BtnRunBatch"
                                Grid.Column="4"
                                Content="🚀 Extraire Batch"
                                Click="BtnRunBatch_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                Width="140"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. CARTE SUIVI & TABLEAU VERT / ROUGE (ÉCHECS / NON ACTIFS EN HAUT) -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barre de compteurs + actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Suivi des Extractions"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <!-- Badge Total -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BadgeExtAll_Click" ToolTip="Afficher tout">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total : " FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>

                            <!-- Badge VERT : Actifs (LISA + ELIA) -->
                            <Border Background="{StaticResource SuccessLight}" BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BadgeExtGreen_Click" ToolTip="Filtrer uniquement les contrats actifs (LISA + ELIA)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟢 Actifs (LISA+ELIA) : " FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                    <TextBlock x:Name="TxtOkCount" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                </StackPanel>
                            </Border>

                            <!-- Badge ROUGE : Non actifs / KO -->
                            <Border Background="{StaticResource DangerLight}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BadgeExtFailed_Click" ToolTip="Filtrer uniquement les contrats ELIA Only / KO (affichés en haut)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔴 Non actifs / KO : " FontWeight="SemiBold" Foreground="{StaticResource Danger}" FontSize="11.5"/>
                                    <TextBlock x:Name="TxtKoCount" Text="0" FontWeight="Bold" Foreground="{StaticResource Danger}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnExportExtHistoryCsv"
                                    Content="📥 Export CSV"
                                    Click="BtnExportExtHistoryCsv_Click"
                                    Cursor="Hand"
                                    Padding="9,4"
                                    Margin="0,0,6,0"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Background="#EFF6FF"
                                    Foreground="#2563EB"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"/>
                            <Button x:Name="BtnClearHistory"
                                    Content="🗑️ Vider"
                                    Click="BtnClearHistory_Click"
                                    Cursor="Hand"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Background="White"
                                    Foreground="{StaticResource Danger}"
                                    BorderBrush="{StaticResource DangerBorder}"
                                    BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Barre de progression compacte sur 1 ligne -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,10,0">
                                <Run x:Name="TxtExtBatchCurrentContract" Text="Prêt" Foreground="#1E40AF" FontWeight="SemiBold"/>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtExtBatchProcessedCount" Text="0" FontWeight="Bold" Foreground="#047857" FontSize="11.5"/>
                                <TextBlock Text="/" Foreground="#64748B" FontSize="11.5"/>
                                <TextBlock x:Name="TxtExtBatchPlannedCount" Text="0" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5"/>
                                <TextBlock x:Name="TxtExtElapsedTime" Text="  ⏱️ 0.0s" Foreground="#475569" FontSize="11.5"/>
                                <TextBlock x:Name="TxtExtBatchProgressPercentage" Text="0%" FontWeight="Bold" FontSize="11.5" Foreground="#2563EB" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ProgressBar x:Name="ProgressBatchExtraction"
                                         Grid.Column="2"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="0"
                                         Foreground="#2563EB"
                                         Background="#DBEAFE"/>
                        </Grid>
                    </Border>

                    <!-- Barre de recherche rapide -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFilterExtHistory"
                                 Grid.Column="0"
                                 Padding="8,4"
                                 FontSize="12"
                                 BorderBrush="#CBD5E1"
                                 ToolTip="Filtrer par Contrat, Demand ID, LISA ID, Produit, Row..."
                                 TextChanged="FilterExtHistory_Changed"/>
                        <ComboBox x:Name="CmbFilterExtBranch"
                                  Grid.Column="2"
                                  Padding="7,4"
                                  FontSize="12"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterExtHistory_Changed">
                            <ComboBoxItem Content="Toutes Branches" Tag="ALL"/>
                            <ComboBoxItem Content="Branche 21" Tag="Branche 21"/>
                            <ComboBoxItem Content="Branche 23" Tag="Branche 23"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbFilterExtStatus"
                                  Grid.Column="4"
                                  Padding="7,4"
                                  FontSize="12"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterExtHistory_Changed">
                            <ComboBoxItem Content="Tous Statuts" Tag="ALL"/>
                            <ComboBoxItem Content="🟢 Actifs (LISA + ELIA)" Tag="OK"/>
                            <ComboBoxItem Content="🔴 Non actifs / KO" Tag="KO_OR_ELIA"/>
                        </ComboBox>
                    </Grid>

                    <!-- Tableau Vert / Rouge épuré (11 colonnes essentielles, double-clic = rapport complet) -->
                    <ListView x:Name="ListHistory"
                              Grid.Row="3"
                              Background="White"
                              BorderBrush="{StaticResource BorderDefault}"
                              BorderThickness="1"
                              MinHeight="230"
                              MaxHeight="480"
                              MouseDoubleClick="ListHistory_MouseDoubleClick"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔍 Ouvrir le rapport d'extraction SQL" Click="MenuExtInspect_Click" FontWeight="Bold"/>
                                <MenuItem Header="⚡ Envoyer vers Activation" Click="MenuExtSendToActivation_Click" FontWeight="Bold"/>
                                <Separator/>
                                <MenuItem Header="🔄 Charger dans le champ Unitaire" Click="MenuExtLoadSingle_Click"/>
                                <MenuItem Header="📋 Copier le N° de Contrat" Click="MenuExtCopyContract_Click"/>
                                <MenuItem Header="📋 Copier le Demand ID" Click="MenuExtCopyDemand_Click"/>
                                <MenuItem Header="📂 Ouvrir le fichier CSV extrait" Click="MenuExtOpenCsv_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,5"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Style.Triggers>
                                    <!-- VERT : Contrat actif dans LISA + ELIA -->
                                    <DataTrigger Binding="{Binding IsGreen}" Value="True">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                    </DataTrigger>
                                    <!-- ROUGE : Contrat ELIA ONLY ou KO (affiché en haut) -->
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <!-- 1. Statut Vert / Rouge -->
                                <GridViewColumn Header="Statut" Width="115">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="StatusBadge"
                                                    Background="#DCFCE7"
                                                    BorderBrush="#86EFAC"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="7,2"
                                                    HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtStatus"
                                                           Text="{Binding StatusBadgeText}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#15803D"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2"/>
                                                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FCA5A5"/>
                                                    <Setter TargetName="TxtStatus" Property="Foreground" Value="#B91C1C"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 2. Excel Row -->
                                <GridViewColumn Header="Row" DisplayMemberBinding="{Binding RowNum}" Width="52"/>

                                <!-- 3. Env -->
                                <GridViewColumn Header="Env" DisplayMemberBinding="{Binding Env}" Width="50"/>

                                <!-- 4. Contrat (3-7-2) -->
                                <GridViewColumn Header="Contrat" Width="125">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ContractId}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 5. Demand ID -->
                                <GridViewColumn Header="Demand ID" DisplayMemberBinding="{Binding Hdmd}" Width="95"/>

                                <!-- 6. LISA ID -->
                                <GridViewColumn Header="LISA ID" Width="85">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InternalId}" Foreground="{StaticResource PrimaryAction}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 7. Branche -->
                                <GridViewColumn Header="Branche" Width="92">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="BranchText" Text="{Binding BranchDisplay}" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBranch23}" Value="True">
                                                    <Setter TargetName="BranchText" Property="Foreground" Value="#6D28D9"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 8. Produit (Process) -->
                                <GridViewColumn Header="Produit (Proc.)" DisplayMemberBinding="{Binding ProductProcessDisplay}" Width="105"/>

                                <!-- 9. Canal (BUCP/CMD) -->
                                <GridViewColumn Header="Canal (BUCP/CMD)" DisplayMemberBinding="{Binding ChannelPaymentDisplay}" Width="140"/>

                                <!-- 10. Prime -->
                                <GridViewColumn Header="Prime" DisplayMemberBinding="{Binding Premium}" Width="82"/>

                                <!-- 11. Fonds / Résumé ou Raison KO -->
                                <GridViewColumn Header="Fonds / Résultat" Width="320">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="SummaryText"
                                                       Text="{Binding SummaryDisplay}"
                                                       Foreground="#166534"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SummaryDisplay}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter TargetName="SummaryText" Property="Foreground" Value="#991B1B"/>
                                                    <Setter TargetName="SummaryText" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
