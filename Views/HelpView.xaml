<UserControl x:Class="AutoActivator.Gui.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Centre d'Aide &amp; Référentiel Métier / Technique (LISA &amp; ELIA)"
                       TextWrapping="Wrap"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
            <TextBlock Text="Guide de la logique d'Autocomplete SQL, routage Banque vs Broker, classification Branche 21 vs Branche 23, exécution LVCHAIN, Extraction SQL et Comparaison."
                       TextWrapping="Wrap"
                       FontSize="12.5"
                       Foreground="#64748B"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="6"
                Padding="14,10"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Garanties de cohérence End-to-End (Contrat / Demand ID / Environnement / Unitaire &amp; Batch)"
                           TextWrapping="Wrap"
                           FontWeight="Bold"
                           FontSize="13.5"
                           Foreground="#0F172A"
                           Margin="0,0,0,3"/>
                <TextBlock Text="Que vous saisissiez un Numéro de Contrat (3-7-2 ou JCL 9 chiffres) ou une Demand ID, en D000 ou Q000, en mode Unitaire ou Batch Excel : l'application exécute exactement le même moteur d'Autocomplete SQL, résout les mêmes paramètres (BUCP, CMDPMT, Prime, Date N, Date N+2, Fonds) et applique les mêmes contrôles métier."
                           TextWrapping="Wrap"
                           Foreground="#475569"
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="HelpTabControl"
                    Grid.Row="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- TAB 0 : AUTOCOMPLETE, BANQUE/BROKER & BRANCHE 21/23 -->
            <TabItem Header="1. Activation, Banque/Broker &amp; Branche 21/23">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <StackPanel>
                        <TextBlock Text="1. Logique de l'Autocomplete SQL"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#334155"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Margin="0,0,0,12">
                            Lors du lancement d'une activation (en mode Unitaire comme en Batch Excel), le moteur interroge automatiquement SQL Server (Q000 : DBMFBDBQ / D000 : DBMFBDBD) pour construire un plan d'activation déterministe en CLASS=I.
                        </TextBlock>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="- Détection bidirectionnelle Contrat / Demand ID :"
                                           FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Que vous entriez un contrat externe 12 chiffres (ex. 582-2437921-78), un numéro technique JCL 9 chiffres / NO_CNT (ex. 822437921) ou une Demand ID ELIA, l'application retrouve le triptyque DemandId (FJ1.TB5HDMD), EliaId / UCON (FJ1.TB5HELT &amp; FJ1.TB5UCON), Contrat (IT5UCONLREFEXN) et état LISA (LV000SD0.LV.SCNTT0)."
                                           TextWrapping="Wrap" Margin="12,0,0,8" FontSize="12" Foreground="#475569"/>

                                <TextBlock Text="- Déduction mathématique NO_CNT (9 chiffres) :"
                                           FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="À partir du contrat 3-7-2 (12 chiffres), l'application extrait directement les 9 chiffres centraux (positions 2 à 10) correspondant au NO_CNT LISA et aux variables CNTBEG / CNTEND."
                                           TextWrapping="Wrap" Margin="12,0,0,8" FontSize="12" Foreground="#475569"/>

                                <TextBlock Text="- Mode Skip Prime (Rejeu IMS &amp; LVDQ) :"
                                           FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="En cliquant sur Skip Prime (Unitaire ou Batch), les étapes de facturation/prime (ADDPRCT, LVPP06U, LVPG22U) sont ignorées et les jobs restants (LI1J04D0, LI1J04D2 ainsi que SQL VNI et LVDQFG03/LVDQFG01 en Branche 23) sont effectivement rejoués même si le contrat est déjà présent à l'état 4 dans LV.SCNTT0."
                                           TextWrapping="Wrap" Margin="12,0,0,0" FontSize="12" Foreground="#475569"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2. Routage Banque vs Broker (BUCP &amp; CMDPMT)"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CANAL BANQUE (BANK)"
                                           FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,3"/>
                                <TextBlock Text="- Codes Canal ELIA (IT5HDMDCCDI) : 01, 02, 04, 05, 13, 18, 22, 23, 24 -> BUCP = 00382 | CMDPMT = 8 (ou variante P48LV : 00182 / 8)."
                                           TextWrapping="Wrap" Foreground="#475569" Margin="10,0,0,10" FontSize="12"/>

                                <TextBlock Text="CANAL BROKER NEW GENERATION / 2P (BROKER_NEW_GEN)"
                                           FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,3"/>
                                <TextBlock Text="- Codes Canal ELIA (IT5HDMDCCDI) : 03, 06, 07, 08, 09, 10, 11, 12, 14, 15, 16, 17, 19, 20, 21 -> BUCP = 80819 | CMDPMT = H."
                                           TextWrapping="Wrap" Foreground="#475569" Margin="10,0,0,10" FontSize="12"/>

                                <TextBlock Text="CANAL BROKER CLASSIQUE (BROKER_LEGACY)"
                                           FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,3"/>
                                <TextBlock Text="- AGF+ / AG Target+ : BUCP = 49797 | CMDPMT = X.  AG Invest+ : BUCP = 49797 | CMDPMT = H."
                                           TextWrapping="Wrap" Foreground="#475569" Margin="10,0,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="3. Pipeline Unifié Branche 21 &amp; Branche 23"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="- Socle commun (B21 &amp; B23) : ADDPRCT -> LVPP06U -> LVPG22U -> LI1J04D0 (LI1J04D1) -> LI1J04D2 (LI1J04D3) -> Contrôle final LV.SCNTT0."
                                           TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,6" FontSize="12"/>
                                <TextBlock Text="- Extension exclusive Branche 23 : Préparation SQL VNI (LV000GD0.LV.GFCRT0 / GFEVT0 de Date N à Date N+2) -> LVDQFG03 (Date N, mouvement état 2) -> LVDQFG01 (Date N+2, consolidation état 4) -> LVD1PE01 (optionnel)."
                                           TextWrapping="Wrap" Foreground="#334155" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 1 : EXTRACTION SQL -->
            <TabItem Header="2. Extraction SQL (LISA &amp; ELIA)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Extraction SQL Parallèle Multi-Tables (32 tables LISA &amp; 24 tables ELIA)"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#334155"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Margin="0,0,0,14">
                            Extrait en parallèle les 32 tables LISA et 24 tables ELIA / Demand d'un contrat unitaire ou d'un fichier Batch Excel/CSV lu directement en mémoire, en conservant le numéro exact de ligne Excel (tri croissant garanti).
                        </TextBlock>
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="- Double-cliquez sur une ligne pour consulter le rapport complet et l'aperçu des tables SQL extraites."
                                           TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,6" FontSize="12"/>
                                <TextBlock Text="- Utilisez le menu contextuel pour envoyer directement un contrat vers l'Activation ou ouvrir le fichier CSV généré."
                                           TextWrapping="Wrap" Foreground="#334155" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2 : COMPARAISON NON-REGRESSION -->
            <TabItem Header="3. Comparaison &amp; Différences ignorées">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Comparaison Côte à Côte SOURCE vs TARGET"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#334155"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Margin="0,0,0,14">
                            La vue Comparaison affiche à gauche la liste des tables SQL (filtrée par défaut sur les tables en écart) et à droite le détail côte à côte des valeurs SOURCE et TARGET, avec mise en évidence en rouge uniquement sur les différences actives.
                        </TextBlock>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="- Lignes / tables absentes ou ajoutées : résumées en une seule ligne synthétique par enregistrement avec sa clé métier."
                                           TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,6" FontSize="12"/>
                                <TextBlock Text="- Onglet Différences ignorées : répertorie tous les écarts filtrés par les règles d'exclusion (spécifiques table, globales, audit) avec un impact strictement nul (0 %) sur le score et le statut OK/KO."
                                           TextWrapping="Wrap" Foreground="#334155" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
