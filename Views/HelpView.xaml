<UserControl x:Class="AutoActivator.Gui.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Help &amp; Technical Documentation Center" TextWrapping="Wrap" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Complete reference guide for the LISA &amp; ELIA E.T.L Suite: High-speed Mainframe Activation, Parallel SQL Extraction, and Deep Non-Regression Comparison."
                       TextWrapping="Wrap" FontSize="13.5" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" Padding="16,12" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="💡 Recommended E.T.L Non-Regression Workflow" TextWrapping="Wrap" FontWeight="Bold" FontSize="15" Foreground="#1E40AF" Margin="0,0,0,4"/>
                <TextBlock Text="1. Run a Batch Extraction to capture your Baseline state  ➜  2. Run Batch Activation to process contracts on Mainframe  ➜  3. Run a second Extraction to capture the Target state  ➜  4. Use the Smart Baseline Matcher in Comparison to verify 100% non-regression." TextWrapping="Wrap" Foreground="#334155" FontSize="13"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="HelpTabControl" Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="FontSize" Value="14.5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#2563EB"/>
                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <TabItem Header="⚡ 1. Activation &amp; Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22">
                    <StackPanel>
                        <TextBlock Text="High-Speed Contract Activation &amp; Diagnostic Engine" TextWrapping="Wrap" FontSize="19" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="13.5" LineHeight="21" Margin="0,0,0,18">
                            The Activation module automates Mainframe 3270 operations. It resolves contract identifiers and gross premiums in a single SQL query, injects parameters into cached JCL templates in memory, submits jobs via MicroFocus ESCWA REST APIs, and automatically extracts Mainframe Spool outputs if any step fails.
                        </TextBlock>

                        <TextBlock Text="1. Strict Mainframe Formatting Rules" TextWrapping="Wrap" FontWeight="Bold" FontSize="15.5" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="• Target Contract ID (9-Digit JCL Format):" TextWrapping="Wrap" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="When a 12-digit DB contract is provided (e.g., 182-2728195-31), the engine extracts the 9 central digits (822728195) required by Mainframe CNTBEG/CNTEND parameters." TextWrapping="Wrap" Margin="14,0,0,10" FontSize="13" Foreground="#475569"/>

                                <TextBlock Text="• Gross Premium (IT5UPRPUBRU):" TextWrapping="Wrap" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Fetched in a single SQL roundtrip from FJ1.TB5UCON + FJ1.TB5UPRP and formatted to 10 characters with leading zeros (e.g., '0002500.00'). In Batch mode, contracts with 0€ premium are caught immediately during the parallel DB phase without blocking the Mainframe queue." TextWrapping="Wrap" Margin="14,0,0,10" FontSize="13" Foreground="#475569"/>

                                <TextBlock Text="• Distribution Channel Presets (BUCP &amp; CMDPMT):" TextWrapping="Wrap" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Bank (BUCP: 00382, CMDPMT: 8), Broker Old Gen (BUCP: 49797, CMDPMT: X), or Broker New Gen (BUCP: 80819, CMDPMT: H)." TextWrapping="Wrap" Margin="14,0,0,0" FontSize="13" Foreground="#475569"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="2. Mainframe 5-Step JCL Sequence &amp; Low-Latency Polling" TextWrapping="Wrap" FontWeight="Bold" FontSize="15.5" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Phase 1 — Billing &amp; Premium Injection: ADDPRCT ➜ LVPP06U ➜ LVPG22U" TextWrapping="Wrap" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="Assigns and posts the contract premium. Automatically bypassed when Process is 'C05' or when 'Skip Prime' is clicked." TextWrapping="Wrap" Foreground="#15803D" Margin="14,2,0,10" FontSize="13"/>

                                <TextBlock Text="Phase 2 — Core IMS Activation: LI1J04D0 (LI1J04D1) ➜ LI1J04D2 (LI1J04D3)" TextWrapping="Wrap" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="Finalizes the contract status in IMS (IM7T for D000, IM7C for Q000). JCL templates are cached in RAM and polled starting at 200ms intervals for maximum speed." TextWrapping="Wrap" Foreground="#15803D" Margin="14,2,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="3. Detailed Diagnostic Reports &amp; Spool Extraction on Failure" TextWrapping="Wrap" FontWeight="Bold" FontSize="15.5" Foreground="#DC2626" Margin="0,0,0,6"/>
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="16" BorderBrush="#FECACA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔍 Maximum Failure Diagnostics (Live Monitor &amp; TXT Reports)" TextWrapping="Wrap" FontWeight="Bold" FontSize="14.5" Foreground="#991B1B" Margin="0,0,0,6"/>
                                <TextBlock Text="• Every Single and Batch activation records a complete ContractActivationTrace: DB identifiers (UCON ID, Demand ID, LISA NO_CNT), exact step durations, Job Numbers (Jxxxxxx), and Return Codes." TextWrapping="Wrap" Foreground="#7F1D1D" Margin="0,0,0,6" FontSize="13"/>
                                <TextBlock Text="• If any Mainframe job fails (JCLError, Abend, or RC ≠ 0/4), the engine automatically downloads the Mainframe Spool DDs (BERPCTLO, SYSOUT, SYSPRINT, JESYSMSG, JESMSGLG) and embeds them in the report along with a Root-Cause Analysis and Recommended Action." TextWrapping="Wrap" Foreground="#7F1D1D" Margin="0,0,0,6" FontSize="13"/>
                                <TextBlock Text="• Tip: Double-click any row in the Live Activation Monitor table to inspect its full diagnostic report and Mainframe Spool output immediately!" TextWrapping="Wrap" Foreground="#991B1B" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📥 2. Extraction">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Parallel Multi-Table Extraction (LISA &amp; ELIA)" TextWrapping="Wrap" FontSize="19" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="13.5" LineHeight="21" Margin="0,0,0,18">
                            Connects to SQL Server environments (<Run FontWeight="Bold">D000</Run>: <Run FontFamily="Consolas">DBMFBDBD</Run> / <Run FontFamily="Consolas">FJ0AGDB_D000</Run> &amp; <Run FontFamily="Consolas">FJ5LIFE_D000</Run> | <Run FontWeight="Bold">Q000</Run>: <Run FontFamily="Consolas">DBMFBDBQ</Run> / <Run FontFamily="Consolas">FJ0AGDB_Q000</Run> &amp; <Run FontFamily="Consolas">FJ5LIFE_Q000</Run>) to extract 32 LISA tables and 23 ELIA/Demand tables in parallel, formatting them into structured CSV snapshots for regression testing.
                        </TextBlock>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Batch Input File Rules (Excel / CSV)" TextWrapping="Wrap" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,8"/>
                                <TextBlock Text="1. Search by Contract ID: The file must contain a column header named 'LISA Contract'." TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="14,0,0,16" HorizontalAlignment="Left" Padding="4" Background="White">
                                    <Image Source="/Images/TemplateContractLisa.png" Width="380" Stretch="Uniform"/>
                                </Border>

                                <TextBlock Text="2. Search by Demand ID: The file must contain a column header named 'Value' (typically on Row 2 in Testing Team Excel sheets)." TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="14,0,0,6" HorizontalAlignment="Left" Padding="4" Background="White">
                                    <Image Source="/Images/TemplateDemandValue.png" Width="380" Stretch="Uniform"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📊 3. Comparison">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Deep Non-Regression Comparison Engine" TextWrapping="Wrap" FontSize="19" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#334155" FontSize="13.5" LineHeight="21" Margin="0,0,0,18">
                            Compares Baseline and Target CSV snapshots table by table, row by row, and cell by cell using single-pass $O(N)$ streaming and 128-bit decimal normalization.
                        </TextBlock>

                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Comparison Status Codes &amp; Scoring:" TextWrapping="Wrap" FontWeight="Bold" FontSize="15" Foreground="#065F46" Margin="0,0,0,8"/>
                                <TextBlock Text="• OK / OK_EMPTY : 100% identical data (after volatile timestamp/ID exclusions and 4-decimal rounding)." TextWrapping="Wrap" Foreground="#047857" Margin="8,0,0,4" FontWeight="SemiBold"/>
                                <TextBlock Text="• KO_ROW_COUNT : Row count mismatch between Base and Target for a table." TextWrapping="Wrap" Foreground="#DC2626" Margin="8,0,0,4" FontWeight="SemiBold"/>
                                <TextBlock Text="• KO : Cell-level differences detected (exact row, column, Base value, and Target value are listed)." TextWrapping="Wrap" Foreground="#DC2626" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>