<UserControl x:Class="AutoActivator.Gui.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- En-tête de tableau léger et sobre (plus de bandeau noir massif) -->
        <Style x:Key="LightGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactInputBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE SOBRE -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Comparaison Non-Régression"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnAddBaselineComp"
                        Content="Ajouter dernière extraction aux Baselines"
                        Click="BtnAddBaseline_Click"
                        Style="{StaticResource NeutralButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- CARTE CONFIGURATION COMPACTE (SANS ENCADRÉ FLASHY) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
            <StackPanel>
                <!-- Ligne 1 : Sélecteur rapide Baseline + SOURCE + TARGET -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Environnement :" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbSmartEnv" Style="{StaticResource CompactComboStyle}" SelectionChanged="SmartMatcher_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="D000 (Env D)" Tag="D"/>
                            <ComboBoxItem Content="Q000 (Env Q)" Tag="Q"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Baseline rapide (auto-match) :" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbBaselineSelector" Style="{StaticResource CompactComboStyle}" SelectionChanged="SmartMatcher_Changed"/>
                    </StackPanel>

                    <!-- SOURCE -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fichier SOURCE (Baseline CSV) :" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtBaseFile"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Style="{StaticResource CompactInputBoxStyle}"
                                     Background="#F8FAFC"
                                     Margin="0,0,4,0"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button Grid.Column="1"
                                    Content="Ouvrir"
                                    Click="BtnOpenBaseFile_Click"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,4"
                                    Margin="0,0,4,0"/>
                            <Button Grid.Column="2"
                                    Content="Parcourir"
                                    Click="BtnBrowseBase_Click"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,4"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="5"
                            Content="&lt;-&gt;"
                            ToolTip="Inverser Source et Target"
                            Click="BtnSwapFiles_Click"
                            Style="{StaticResource NeutralButtonStyle}"
                            Padding="7,4"
                            Margin="8,18,8,0"
                            VerticalAlignment="Top"/>

                    <!-- TARGET -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Fichier TARGET (Extrait CSV) :" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTargetFile"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Style="{StaticResource CompactInputBoxStyle}"
                                     Background="#F8FAFC"
                                     Margin="0,0,4,0"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button Grid.Column="1"
                                    Content="Ouvrir"
                                    Click="BtnOpenTargetFile_Click"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,4"
                                    Margin="0,0,4,0"/>
                            <Button Grid.Column="2"
                                    Content="Parcourir"
                                    Click="BtnBrowseTarget_Click"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Ligne 2 : Option audit + Barre de progression fine + Comparer + Stop -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkIgnoreTechColumns"
                              Grid.Column="0"
                              Content="Ignorer colonnes d'audit"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              FontSize="12"
                              Foreground="#334155"
                              Cursor="Hand"
                              Click="ChkIgnoreTechColumns_Click"
                              ToolTip="Ignore les horodatages techniques supplémentaires ; ils restent visibles dans l'onglet Différences ignorées (0% impact score)"/>

                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <Run x:Name="TxtCompProgressDetail" Text="Prêt — sélectionnez SOURCE et TARGET" Foreground="#334155" FontWeight="SemiBold"/>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCompProcessedCount" Text="0" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5"/>
                                    <TextBlock Text="/" Foreground="#64748B" FontSize="11.5" Margin="2,0"/>
                                    <TextBlock x:Name="TxtCompPlannedCount" Text="0" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5"/>
                                    <TextBlock x:Name="TxtCompElapsedTime" Text="  0.0s" FontWeight="SemiBold" Foreground="#64748B" FontSize="11.5" Margin="8,0,8,0"/>
                                    <TextBlock x:Name="TxtCompProgressPercentage" Text="0%" FontWeight="Bold" FontSize="11.5" Foreground="#2563EB"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="ProgressComparison"
                                         Grid.Row="1"
                                         Height="4"
                                         Margin="0,3,0,0"
                                         Minimum="0"
                                         Maximum="1000"
                                         Value="0"
                                         Foreground="#2563EB"
                                         Background="#E2E8F0"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnRunComparison"
                            Grid.Column="4"
                            Content="Comparer"
                            Click="BtnRunComparisonAction_Click"
                            Style="{DynamicResource ActionButtonStyle}"
                            Width="118"
                            IsEnabled="False"/>

                    <Button x:Name="BtnCancelComparison"
                            Grid.Column="6"
                            Content="Stop"
                            Click="BtnCancelComparison_Click"
                            Style="{DynamicResource CancelButtonStyle}"
                            Width="70"
                            IsEnabled="False"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- LIGNE DE SYNTHÈSE ÉPURÉE (REMPLACE LA JAUGE ET LES 6 CARTES FLASHY — SEULS LES ÉCARTS EN ROUGE) -->
        <Border x:Name="PanelDashboard"
                Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="14,8"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Conformité : " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtScorePercentage" Text="100%" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <TextBlock Text="   |   Contrats : " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtComparedTests" Text="0" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <TextBlock Text="   |   Tables identiques : " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTablesMatched" Text="0 / 0" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <TextBlock Text="   |   Tables en écart : " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CardActiveDiffs_Click"/>
                    <TextBlock x:Name="TxtKoTablesCount" Text="0" FontSize="13" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CardActiveDiffs_Click" ToolTip="Cliquer pour filtrer sur les tables en écart"/>

                    <TextBlock Text="   |   Lignes KO : " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRowsKoSummary" Text="0 / 0" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <TextBlock Text="   |   Différences ignorées : " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CardIgnoredDiffs_Click"/>
                    <TextBlock x:Name="TxtIgnoredSummary" Text="0 (0% impact)" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="CardIgnoredDiffs_Click" ToolTip="Cliquer pour consulter les différences ignorées"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExportComparisonCsv"
                            Content="Exporter CSV"
                            Click="BtnExportComparisonCsv_Click"
                            Style="{StaticResource NeutralButtonStyle}"
                            Padding="10,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ZONE PRINCIPALE MAÎTRE-DÉTAIL (HEIGHT=*, ZÉRO SCROLL DE PAGE) -->
        <Grid Grid.Row="3">
            <Border x:Name="PanelWaitingCard" Style="{StaticResource CardBorderStyle}" Padding="32">
                <TextBlock x:Name="TxtComparisonWaiting"
                           Text="Sélectionnez les fichiers CSV SOURCE (Baseline) et TARGET ci-dessus, puis cliquez sur Comparer."
                           Foreground="#64748B"
                           FontSize="13.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>

            <TabControl x:Name="TabComparisonMain"
                        Visibility="Collapsed"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="10,8">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="14,7"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- ========================================================================= -->
                <!-- ONGLET 1 : ÉCARTS MÉTIER — VUE SCINDÉE GAUCHE (TABLES) / DROITE (DÉTAIL)  -->
                <!-- ========================================================================= -->
                <TabItem x:Name="TabActiveDiffs">
                    <TabItem.Header>
                        <TextBlock x:Name="TxtTabActiveHeader" Text="Écarts métier"/>
                    </TabItem.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" MinWidth="280"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- PANNEAU GAUCHE : LISTE DES TABLES SQL -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Barre de filtre simple -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFilterComparison"
                                         Grid.Column="0"
                                         Style="{StaticResource CompactInputBoxStyle}"
                                         ToolTip="Filtrer par nom de table SQL, colonne en écart ou contrat..."
                                         TextChanged="FilterComparison_Changed"/>
                                <ComboBox x:Name="CmbFilterCompStatus"
                                          Grid.Column="2"
                                          Style="{StaticResource CompactComboStyle}"
                                          SelectedIndex="1"
                                          SelectionChanged="CmbFilterCompStatus_SelectionChanged">
                                    <ComboBoxItem Content="Toutes les tables" Tag="ALL"/>
                                    <ComboBoxItem Content="Écarts uniquement" Tag="KO"/>
                                    <ComboBoxItem Content="Identiques (OK)" Tag="OK"/>
                                </ComboBox>
                            </Grid>

                            <!-- Sélecteur de contrat (affiché uniquement si batch > 1 contrat) + compteur -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbFilterCompContract"
                                          Grid.Column="0"
                                          Style="{StaticResource CompactComboStyle}"
                                          SelectedIndex="0"
                                          Margin="0,0,8,0"
                                          Visibility="Collapsed"
                                          SelectionChanged="FilterComparison_Changed">
                                    <ComboBoxItem Content="Tous les contrats" Tag="ALL"/>
                                </ComboBox>
                                <TextBlock x:Name="TxtFilteredTablesCount"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="#64748B"/>
                            </Grid>

                            <!-- Liste épurée des tables SQL -->
                            <DataGrid x:Name="GridResults"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="False"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      Background="White"
                                      BorderBrush="#E2E8F0"
                                      BorderThickness="1"
                                      HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource LightGridHeaderStyle}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      SelectionMode="Single"
                                      SelectionChanged="GridResults_SelectionChanged"
                                      MouseDoubleClick="GridResults_MouseDoubleClick"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Padding" Value="0,2"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Ouvrir le rapport brut complet de la table" Click="MenuCompInspect_Click" FontWeight="SemiBold"/>
                                        <Separator/>
                                        <MenuItem Header="Re-extraire ce contrat" Click="MenuCompSendToExtraction_Click"/>
                                        <MenuItem Header="Envoyer ce contrat vers Activation" Click="MenuCompSendToActivation_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Copier le N° de Contrat" Click="MenuCompCopyContract_Click"/>
                                        <MenuItem Header="Copier les écarts de la table" Click="BtnCopyInlineDiff_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <!-- Table SQL -->
                                    <DataGridTemplateColumn Header="Table SQL" Width="138">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="TblText"
                                                           Text="{Binding CleanTableName}"
                                                           FontFamily="Consolas"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                                        <Setter TargetName="TblText" Property="Foreground" Value="#DC2626"/>
                                                        <Setter TargetName="TblText" Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Contrat (affiché uniquement si batch multi-contrats) -->
                                    <DataGridTextColumn x:Name="ColCompContract"
                                                        Header="Contrat"
                                                        Binding="{Binding ContractNumber}"
                                                        Width="112"
                                                        FontFamily="Consolas"
                                                        FontSize="11.5"
                                                        Visibility="Collapsed"/>

                                    <!-- Lignes Src -> Tgt -->
                                    <DataGridTextColumn Header="Lignes"
                                                        Binding="{Binding VolumeDisplay}"
                                                        Width="74"
                                                        FontFamily="Consolas"
                                                        FontSize="11.5"
                                                        Foreground="#475569"/>

                                    <!-- Résumé écarts (Rouge uniquement si KO) -->
                                    <DataGridTemplateColumn Header="Statut / Écarts" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="DiffSummaryTxt"
                                                           Text="{Binding CompactStatusSummary}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#DC2626"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DifferingColumnsSummary}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                        <Setter TargetName="DiffSummaryTxt" Property="Foreground" Value="#64748B"/>
                                                        <Setter TargetName="DiffSummaryTxt" Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- SÉPARATEUR REDIMENSIONNABLE -->
                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      Cursor="SizeWE"/>

                        <!-- PANNEAU DROIT : DÉTAIL CÔTE À CÔTE SOURCE vs TARGET DE LA TABLE SÉLECTIONNÉE -->
                        <Border Grid.Column="2"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- En-tête de la table sélectionnée -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtInlineDiffHeader"
                                                   Text="Sélectionnez une table à gauche"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"/>
                                        <TextBlock x:Name="TxtInlineDiffSubHeader"
                                                   Text="-"
                                                   FontSize="11.5"
                                                   Foreground="#64748B"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="BtnJumpToTableIgnored"
                                                Content="Ignorées (0)"
                                                Click="BtnJumpToTableIgnored_Click"
                                                Style="{StaticResource NeutralButtonStyle}"
                                                Padding="8,3"
                                                Margin="0,0,5,0"
                                                Visibility="Collapsed"/>
                                        <Button Content="Copier"
                                                Click="BtnCopyInlineDiff_Click"
                                                Style="{StaticResource NeutralButtonStyle}"
                                                Padding="8,3"
                                                Margin="0,0,5,0"/>
                                        <Button Content="Rapport brut"
                                                Click="MenuCompInspect_Click"
                                                Style="{StaticResource NeutralButtonStyle}"
                                                Padding="8,3"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Message table identique -->
                                <Border x:Name="PanelSelectedTableMatchBanner"
                                        Grid.Row="1"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="16"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TxtSelectedTableMatchMessage"
                                               Text="Aucune différence métier active sur cette table."
                                               FontSize="12.5"
                                               Foreground="#475569"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Grille Côte à Côte SOURCE vs TARGET (Fond blanc pur, SEUL TARGET en rouge) -->
                                <DataGrid x:Name="GridCellDiffs"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="False"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          Background="White"
                                          BorderBrush="#E2E8F0"
                                          BorderThickness="1"
                                          HeadersVisibility="Column"
                                          ColumnHeaderStyle="{StaticResource LightGridHeaderStyle}"
                                          RowBackground="White"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          VerticalGridLinesBrush="#F1F5F9"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ligne / Clé"
                                                            Binding="{Binding RowAndKeyDisplay}"
                                                            Width="185"
                                                            FontFamily="Consolas"
                                                            FontSize="11.5"
                                                            Foreground="#475569"/>

                                        <DataGridTextColumn Header="Colonne"
                                                            Binding="{Binding ColumnName}"
                                                            Width="155"
                                                            FontFamily="Consolas"
                                                            FontWeight="SemiBold"
                                                            FontSize="12"
                                                            Foreground="#0F172A"/>

                                        <!-- Valeur SOURCE (Baseline) : neutre -->
                                        <DataGridTemplateColumn Header="Valeur SOURCE (Baseline)" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SourceDisplay}"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               Foreground="#334155"
                                                               TextWrapping="Wrap"
                                                               ToolTip="{Binding SourceDisplay}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Valeur TARGET (Extrait) : ROUGE UNIQUEMENT SUR LA DIFFÉRENCE -->
                                        <DataGridTemplateColumn Header="Valeur TARGET (Extrait)" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TargetDisplay}"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#DC2626"
                                                               TextWrapping="Wrap"
                                                               ToolTip="{Binding TargetDisplay}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========================================================================= -->
                <!-- ONGLET 2 : DIFFÉRENCES IGNORÉES (0% IMPACT SUR LE SCORE)                  -->
                <!-- ========================================================================= -->
                <TabItem x:Name="TabIgnoredDiffs">
                    <TabItem.Header>
                        <TextBlock x:Name="TxtTabIgnoredHeader" Text="Différences ignorées (0)"/>
                    </TabItem.Header>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barre de filtres sobre sur 1 ligne -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="195"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtFilterIgnored"
                                     Grid.Column="0"
                                     Style="{StaticResource CompactInputBoxStyle}"
                                     ToolTip="Rechercher par table SQL, colonne ignorée, contrat, clé ou valeur..."
                                     TextChanged="FilterIgnored_Changed"/>

                            <ComboBox x:Name="CmbFilterIgnoredCategory"
                                      Grid.Column="2"
                                      Style="{StaticResource CompactComboStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbFilterIgnoredCategory_SelectionChanged">
                                <ComboBoxItem Content="Toutes les règles" Tag="ALL"/>
                                <ComboBoxItem Content="Spécifiques table" Tag="SPECIFIC"/>
                                <ComboBoxItem Content="Exclusions globales" Tag="GLOBAL"/>
                                <ComboBoxItem Content="Audit / Timestamps" Tag="AUDIT"/>
                            </ComboBox>

                            <ComboBox x:Name="CmbFilterIgnoredContract"
                                      Grid.Column="4"
                                      Style="{StaticResource CompactComboStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="FilterIgnored_Changed">
                                <ComboBoxItem Content="Tous les contrats" Tag="ALL"/>
                            </ComboBox>

                            <TextBlock x:Name="TxtFilteredIgnoredCount"
                                       Grid.Column="6"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="#64748B"/>

                            <Button x:Name="BtnExportIgnoredCsv"
                                    Grid.Column="8"
                                    Content="Exporter CSV"
                                    Click="BtnExportIgnoredCsv_Click"
                                    Style="{StaticResource NeutralButtonStyle}"/>
                        </Grid>

                        <!-- Grille sobre des différences ignorées -->
                        <DataGrid x:Name="GridIgnoredDiffs"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Background="White"
                                  BorderBrush="#E2E8F0"
                                  BorderThickness="1"
                                  HeadersVisibility="Column"
                                  ColumnHeaderStyle="{StaticResource LightGridHeaderStyle}"
                                  RowBackground="White"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  VerticalGridLinesBrush="#F1F5F9"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Table SQL"
                                                    Binding="{Binding CleanTableName}"
                                                    Width="135"
                                                    FontFamily="Consolas"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"
                                                    Foreground="#0F172A"/>

                                <DataGridTextColumn Header="Colonne ignorée"
                                                    Binding="{Binding ColumnName}"
                                                    Width="165"
                                                    FontFamily="Consolas"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"
                                                    Foreground="#334155"/>

                                <DataGridTextColumn Header="Règle"
                                                    Binding="{Binding CategoryBadge}"
                                                    Width="135"
                                                    FontSize="11.5"
                                                    Foreground="#475569"/>

                                <DataGridTextColumn Header="Contrat"
                                                    Binding="{Binding ContractAndTestDisplay}"
                                                    Width="150"
                                                    FontFamily="Consolas"
                                                    FontSize="11.5"
                                                    Foreground="#475569"/>

                                <DataGridTextColumn Header="Ligne / Clé"
                                                    Binding="{Binding RowAndKeyDisplay}"
                                                    Width="175"
                                                    FontFamily="Consolas"
                                                    FontSize="11.5"
                                                    Foreground="#64748B"/>

                                <DataGridTemplateColumn Header="Valeur SOURCE" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceDisplay}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="#334155"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding SourceDisplay}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Valeur TARGET" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TargetDisplay}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="#DC2626"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding TargetDisplay}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
