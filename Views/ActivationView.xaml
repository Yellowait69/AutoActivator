<UserControl x:Class="AutoActivator.Gui.Views.ActivationView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Background="Transparent">

     <UserControl.Resources>
         <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
         <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />
         <SolidColorBrush x:Key="BorderDefault" Color="#E2E8F0" />
         <SolidColorBrush x:Key="SurfaceMuted" Color="#F8FAFC" />
         <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB" />
         <SolidColorBrush x:Key="SuccessGreen" Color="#10B981" />
         <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B" />
         <SolidColorBrush x:Key="DangerRed" Color="#EF4444" />
         <SolidColorBrush x:Key="Branch23Purple" Color="#7C3AED" />

         <Style x:Key="CardStyle" TargetType="Border">
             <Setter Property="Background" Value="White" />
             <Setter Property="CornerRadius" Value="10" />
             <Setter Property="Padding" Value="22,18" />
             <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
             <Setter Property="BorderThickness" Value="1" />
         </Style>

         <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
             <Setter Property="FontWeight" Value="SemiBold" />
             <Setter Property="FontSize" Value="12.5" />
             <Setter Property="Foreground" Value="#334155" />
             <Setter Property="Margin" Value="0,0,0,6" />
         </Style>

         <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
             <Setter Property="Padding" Value="8,7" />
             <Setter Property="FontSize" Value="13.5" />
             <Setter Property="BorderBrush" Value="#CBD5E1" />
             <Setter Property="Background" Value="White" />
             <Setter Property="MinHeight" Value="34" />
         </Style>

         <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
             <Setter Property="Padding" Value="8,7" />
             <Setter Property="FontSize" Value="13.5" />
             <Setter Property="BorderBrush" Value="#CBD5E1" />
             <Setter Property="Background" Value="White" />
             <Setter Property="MinHeight" Value="34" />
             <Setter Property="VerticalContentAlignment" Value="Center" />
         </Style>

         <Style TargetType="TabItem">
             <Setter Property="Padding" Value="18,10" />
             <Setter Property="FontSize" Value="13.5" />
             <Setter Property="FontWeight" Value="Bold" />
             <Setter Property="Foreground" Value="#64748B" />
             <Setter Property="Background" Value="#E2E8F0" />
             <Setter Property="Margin" Value="0,0,6,0" />
             <Setter Property="Cursor" Value="Hand" />
             <Setter Property="Template">
                 <Setter.Value>
                     <ControlTemplate TargetType="TabItem">
                         <Border x:Name="TabBorder"
                                 Background="{TemplateBinding Background}"
                                 CornerRadius="8,8,0,0"
                                 Padding="{TemplateBinding Padding}"
                                 Margin="{TemplateBinding Margin}"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1,1,1,0">
                             <ContentPresenter ContentSource="Header"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                         </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsSelected" Value="True">
                                 <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                 <Setter Property="Foreground" Value="#2563EB" />
                             </Trigger>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="TabBorder" Property="Background" Value="#EFF6FF" />
                             </Trigger>
                         </ControlTemplate.Triggers>
                     </ControlTemplate>
                 </Setter.Value>
             </Setter>
         </Style>
     </UserControl.Resources>

     <ScrollViewer VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled"
                   Padding="0,0,10,0">
         <Grid Margin="4">
             <Grid.RowDefinitions>
                 <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
             </Grid.RowDefinitions>

             <Grid Grid.Row="0" Margin="0,0,0,18">
                 <StackPanel HorizontalAlignment="Left">
                     <TextBlock Text="Contract Activation Factory"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimary}" />
                     <TextBlock Text="Automatic ELIA routing, Mainframe JCL orchestration, Branche 21 / Branche 23 detection and spool diagnostics."
                                FontSize="13"
                                Foreground="{StaticResource TextSecondary}"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                 </StackPanel>

                 <Button Content="❓ Help &amp; Docs"
                         Background="#EFF6FF"
                         Foreground="#2563EB"
                         BorderBrush="#BFDBFE"
                         BorderThickness="1"
                         Padding="14,7"
                         Cursor="Hand"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontWeight="Bold"
                         Click="BtnHelp_Click" />
             </Grid>

             <Border Grid.Row="1"
                     Style="{StaticResource CardStyle}"
                     Margin="0,0,0,16">
                 <StackPanel>
                     <TextBlock Text="1. Activation configuration"
                                FontWeight="Bold"
                                FontSize="15.5"
                                Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,12" />

                     <Grid Margin="0,0,0,14">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="24" />
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="24" />
                             <ColumnDefinition Width="*" />
                         </Grid.ColumnDefinitions>

                         <StackPanel Grid.Column="0">
                             <TextBlock Text="Input mode:" Style="{StaticResource FieldLabelStyle}" />
                             <ComboBox x:Name="CmbActivationInputMode"
                                       Style="{StaticResource InputComboBoxStyle}"
                                       SelectedIndex="0"
                                       SelectionChanged="ActivationInputMode_Changed">
                                 <ComboBoxItem Content="Autocomplete based on SQL info" Tag="SqlAutocomplete" />
                                 <ComboBoxItem Content="SQL autocomplete with manual overrides" Tag="SqlAutocompleteWithOverrides" />
                                 <ComboBoxItem Content="Manual variables" Tag="Manual" />
                             </ComboBox>
                             <TextBlock Text="SQL mode automatically resolves process, ChannelCode, Bank or Broker New Gen, BUCP, CMDPMT, premium, Branche 21/23 and business date when Run is clicked."
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondary}"
                                        TextWrapping="Wrap" />
                         </StackPanel>

                         <StackPanel Grid.Column="2">
                             <TextBlock Text="Target Environment:" Style="{StaticResource FieldLabelStyle}" />
                             <ComboBox x:Name="CmbActEnv"
                                       Style="{StaticResource InputComboBoxStyle}"
                                       SelectedIndex="1"
                                       SelectionChanged="CmbActEnv_SelectionChanged">
                                 <ComboBoxItem Content="D000 - Development (IM7T)" Tag="D" />
                                 <ComboBoxItem Content="Q000 - Qualification (IM7C)" Tag="Q" />
                             </ComboBox>
                             <TextBlock Text="Q is selected by default. Use D only when its SQL and Mainframe configuration is validated."
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondary}"
                                        TextWrapping="Wrap" />
                         </StackPanel>

                         <StackPanel Grid.Column="4">
                             <TextBlock Text="CUS Code:" Style="{StaticResource FieldLabelStyle}" />
                             <TextBox x:Name="TxtActCus"
                                      Style="{StaticResource InputTextBoxStyle}"
                                      Margin="0,0,0,12"
                                      Text="MDEEM" />
                             <CheckBox x:Name="ChkActBranch23"
                                       Content="Force Branch 23 workflow"
                                       Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#5B21B6"
                                       Cursor="Hand"
                                       ToolTip="Leave unchecked for automatic ELIA detection. Check only to force BR23." />
                             <TextBlock Text="Leave unchecked for automatic Branche 21/23 detection."
                                        Margin="22,0,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondary}" />
                         </StackPanel>
                     </Grid>

                     <Border x:Name="ManualConfigurationPanel"
                             Background="{StaticResource SurfaceMuted}"
                             BorderBrush="{StaticResource BorderDefault}"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="14,12"
                             Margin="0,0,0,14"
                             Visibility="Collapsed">
                         <StackPanel>
                             <TextBlock Text="Manual variables and overrides (Bank / Broker New Gen / Broker AGF+ &amp; Target+)"
                                        FontWeight="Bold"
                                        Foreground="#334155"
                                        Margin="0,0,0,10" />
                             <Grid>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="1.25*" />
                                     <ColumnDefinition Width="18" />
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="18" />
                                     <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>

                                 <StackPanel Grid.Column="0">
                                     <TextBlock Text="Payment preset (Bank / Broker):" Style="{StaticResource FieldLabelStyle}" />
                                     <RadioButton x:Name="RbPresetBank"
                                                  Content="Bank Standard (BUCP 00382, CMD 8)"
                                                  Margin="0,2,0,5"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand"
                                                  Checked="Preset_Checked" />
                                     <RadioButton x:Name="RbPresetBankLegacy"
                                                  Content="Bank P48LV (BUCP 00182, CMD 8)"
                                                  Margin="0,2,0,5"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand"
                                                  Checked="Preset_Checked" />
                                     <RadioButton x:Name="RbPresetBrokerNew"
                                                  Content="Broker New Gen / 2P (BUCP 80819, CMD H)"
                                                  Margin="0,2,0,5"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand"
                                                  Checked="Preset_Checked" />
                                     <RadioButton x:Name="RbPresetBrokerOld"
                                                  Content="Broker AGF+ / Target+ (BUCP 49797, CMD X)"
                                                  Margin="0,2,0,5"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand"
                                                  Checked="Preset_Checked" />
                                     <RadioButton x:Name="RbPresetBrokerInvest"
                                                  Content="Broker AG Invest+ (BUCP 49797, CMD H)"
                                                  Margin="0,2,0,7"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand"
                                                  Checked="Preset_Checked" />
                                     <Button x:Name="BtnClearPreset"
                                             Content="Clear manual preset"
                                             Padding="10,4"
                                             HorizontalAlignment="Left"
                                             Click="BtnClearPreset_Click" />
                                 </StackPanel>

                                 <StackPanel Grid.Column="2">
                                     <TextBlock Text="Process:" Style="{StaticResource FieldLabelStyle}" />
                                     <ComboBox x:Name="CmbActChannel"
                                               Style="{StaticResource InputComboBoxStyle}"
                                               Margin="0,0,0,12"
                                               SelectedIndex="0"
                                               SelectionChanged="CmbActChannel_SelectionChanged">
                                         <ComboBoxItem Content="(Auto SQL)" Tag="" />
                                         <ComboBoxItem Content="C01 - Standard Life / UL" Tag="C01" />
                                         <ComboBoxItem Content="C02 - Bank Standard" Tag="C02" />
                                         <ComboBoxItem Content="C03 - Classic / Pension" Tag="C03" />
                                         <ComboBoxItem Content="C05 - Direct IMS / No Billing" Tag="C05" />
                                     </ComboBox>
                                     <TextBlock Text="Bureau Number (BUCP):" Style="{StaticResource FieldLabelStyle}" />
                                     <ComboBox x:Name="CmbActBucp"
                                               Style="{StaticResource InputComboBoxStyle}"
                                               Margin="0,0,0,12"
                                               IsEditable="True">
                                         <ComboBoxItem Content="00382" />
                                         <ComboBoxItem Content="00182" />
                                         <ComboBoxItem Content="80819" />
                                         <ComboBoxItem Content="49797" />
                                     </ComboBox>
                                     <TextBlock Text="Override Run Date (YYYY-MM-DD / DD/MM/YYYY, opt.):" Style="{StaticResource FieldLabelStyle}" />
                                     <TextBox x:Name="TxtActOverrideRunDate"
                                              Style="{StaticResource InputTextBoxStyle}"
                                              ToolTip="Optional business date (Date N) override, e.g. 2024-02-19 or 19/02/2024. Leave blank to use SQL effective/creation date." />
                                 </StackPanel>

                                 <StackPanel Grid.Column="4">
                                     <TextBlock Text="Payment Command (CMDPMT):" Style="{StaticResource FieldLabelStyle}" />
                                     <ComboBox x:Name="CmbActCmdpmt"
                                               Style="{StaticResource InputComboBoxStyle}"
                                               Margin="0,0,0,12"
                                               IsEditable="True">
                                         <ComboBoxItem Content="8" />
                                         <ComboBoxItem Content="H" />
                                         <ComboBoxItem Content="X" />
                                     </ComboBox>
                                     <TextBlock Text="BR23 fallback funds:" Style="{StaticResource FieldLabelStyle}" />
                                     <TextBox x:Name="TxtActBranch23Funds"
                                              Style="{StaticResource InputTextBoxStyle}"
                                              Margin="0,0,0,12"
                                              ToolTip="Optional comma-separated fallback fund codes (e.g. F5050, F7525)." />
                                     <TextBlock Text="Override Gross Premium (EUR, opt.):" Style="{StaticResource FieldLabelStyle}" />
                                     <TextBox x:Name="TxtActOverrideAmount"
                                              Style="{StaticResource InputTextBoxStyle}"
                                              ToolTip="Optional gross premium override (e.g. 2500.00). Leave blank to use ELIA SQL GrossPremium." />
                                 </StackPanel>
                             </Grid>
                         </StackPanel>
                     </Border>

                     <!-- GRANULAR JOB / STEP SELECTION PANEL (LVCHAIN & SQL) -->
                     <Border Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="14,12">
                         <StackPanel>
                             <Grid Margin="0,0,0,8">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                 <StackPanel Grid.Column="0">
                                     <TextBlock Text="2. Sélection à la carte des Jobs LVCHAIN &amp; SQL (Un seul job ou plusieurs étapes au choix)"
                                                FontWeight="Bold"
                                                FontSize="13.5"
                                                Foreground="#0F172A" />
                                     <TextBlock Text="Cochez ou décochez librement chaque étape pour exécuter toute la chaîne en une fois, en 2-3 étapes, ou relancer uniquement un job précis (PREMELIA, LVDQFG03, VNI SQL LV000GD0.LV.GFCRT0 ou Consolidation LVDQFG01)."
                                                FontSize="11"
                                                Foreground="#475569"
                                                Margin="0,2,0,0"
                                                TextWrapping="Wrap" />
                                 </StackPanel>
                             </Grid>

                             <WrapPanel Margin="0,0,0,10">
                                 <Button x:Name="BtnJobPresetFull"
                                         Content="✅ Chaîne Complète"
                                         Click="BtnJobPresetFull_Click"
                                         Padding="10,4"
                                         Margin="0,0,6,4"
                                         FontSize="11.5"
                                         FontWeight="Bold"
                                         Background="#EFF6FF"
                                         Foreground="#1D4ED8"
                                         BorderBrush="#BFDBFE"
                                         BorderThickness="1"
                                         Cursor="Hand" />
                                 <Button x:Name="BtnJobPresetPremeliaOnly"
                                         Content="1️⃣ PREMELIA seul (1-3, 6-7)"
                                         Click="BtnJobPresetPremeliaOnly_Click"
                                         Padding="10,4"
                                         Margin="0,0,6,4"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Background="White"
                                         Foreground="#334155"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         Cursor="Hand" />
                                 <Button x:Name="BtnJobPresetNoAddPrct"
                                         Content="⏭️ Sans ADDPRCT (P48LV déjà fait : 2-3, 6-7)"
                                         Click="BtnJobPresetNoAddPrct_Click"
                                         Padding="10,4"
                                         Margin="0,0,6,4"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Background="White"
                                         Foreground="#334155"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         Cursor="Hand" />
                                 <Button x:Name="BtnJobPresetImsOnly"
                                         Content="⚡ IMS 6 &amp; 7 seuls (Après AG Online Broker)"
                                         Click="BtnJobPresetImsOnly_Click"
                                         Padding="10,4"
                                         Margin="0,0,6,4"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Background="White"
                                         Foreground="#334155"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         Cursor="Hand" />
                                 <Button x:Name="BtnJobPresetBr23LvdqOnly"
                                         Content="📈 BR23 : FG03 + SQL VNI + FG01 seuls"
                                         Click="BtnJobPresetBr23LvdqOnly_Click"
                                         Padding="10,4"
                                         Margin="0,0,6,4"
                                         FontSize="11.5"
                                         FontWeight="Bold"
                                         Background="#F5F3FF"
                                         Foreground="#6D28D9"
                                         BorderBrush="#DDD6FE"
                                         BorderThickness="1"
                                         Cursor="Hand" />
                                 <Button x:Name="BtnJobPresetBr23ConsolidateOnly"
                                         Content="🔒 BR23 : SQL VNI + Consolidation FG01 (État 2 -> 4)"
                                         Click="BtnJobPresetBr23ConsolidateOnly_Click"
                                         Padding="10,4"
                                         Margin="0,0,6,4"
                                         FontSize="11.5"
                                         FontWeight="Bold"
                                         Background="#ECFDF5"
                                         Foreground="#047857"
                                         BorderBrush="#A7F3D0"
                                         BorderThickness="1"
                                         Cursor="Hand" />
                             </WrapPanel>

                             <Grid>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="16" />
                                     <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>

                                 <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                     <StackPanel>
                                         <TextBlock Text="Chaîne PREMELIA &amp; IMS (Activation Contrat LISA)"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    Foreground="#1E3A8A"
                                                    Margin="0,0,0,6" />
                                         <CheckBox x:Name="ChkJobAddPrct"
                                                   Content="Ligne 1 : ADDPRCT — Liaison prime dans LV.PRCTT0"
                                                   IsChecked="True"
                                                   Margin="0,2,0,3"
                                                   FontSize="12"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobSqlPrct"
                                                   Content="↳ Alternative SQL : INSERT direct LV000PD0.LV.PRCTT0 (Broker / Sans JCL)"
                                                   IsChecked="False"
                                                   Margin="18,0,0,4"
                                                   FontSize="11.5"
                                                   Foreground="#475569"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobLvpp06u"
                                                   Content="Ligne 2 : LVPP06U — Validation prime P41LV (État 1 -> 2)"
                                                   IsChecked="True"
                                                   Margin="0,2,0,3"
                                                   FontSize="12"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobLvpg22u"
                                                   Content="Ligne 3 : LVPG22U — Quittance &amp; Clearing P15LV"
                                                   IsChecked="True"
                                                   Margin="0,2,0,3"
                                                   FontSize="12"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobLi1j04d0"
                                                   Content="Ligne 6 : LI1J04D0 — Activation IMS D0 / D1"
                                                   IsChecked="True"
                                                   Margin="0,2,0,3"
                                                   FontSize="12"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobLi1j04d2"
                                                   Content="Ligne 7 : LI1J04D2 — Synchro finale IMS D2 / D3 (Contrat ACTIF)"
                                                   IsChecked="True"
                                                   Margin="0,2,0,2"
                                                   FontSize="12"
                                                   Cursor="Hand" />
                                     </StackPanel>
                                 </Border>

                                 <Border Grid.Column="2" Background="White" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                     <StackPanel>
                                         <TextBlock Text="Chaîne LVDQ &amp; VNI SQL (Branche 23 — Fonds &amp; Consolidation)"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    Foreground="#5B21B6"
                                                    Margin="0,0,0,6" />
                                         <CheckBox x:Name="ChkJobLvdqFg03"
                                                   Content="Étape 4 (LVDQ Seq 0) : LVDQFG03 (LVFG03U) à Date N -> Mvt F51LV État 2"
                                                   IsChecked="True"
                                                   Margin="0,2,0,4"
                                                   FontSize="12"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobSqlVni"
                                                   Content="Étape 5 (SQL LV000GD0) : VNI LV.GFCRT0 / GFEVT0 à Date N..N+2"
                                                   IsChecked="True"
                                                   Margin="0,2,0,4"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#4C1D95"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobLvdqFg01"
                                                   Content="Étape 6 (LVDQ Seq 1) : LVDQFG01 (LVFG01U) à Date N+2 -> Mvt F51LV État 4"
                                                   IsChecked="True"
                                                   Margin="0,2,0,4"
                                                   FontSize="12"
                                                   Cursor="Hand" />
                                         <CheckBox x:Name="ChkJobLvd1Pe01"
                                                   Content="Optionnel (LVDQ Seq 3) : LVD1PE01 (LVPE01U) — Comptabilité FP01 EFP"
                                                   IsChecked="False"
                                                   Margin="0,2,0,2"
                                                   FontSize="11.5"
                                                   Foreground="#64748B"
                                                   Cursor="Hand" />
                                     </StackPanel>
                                 </Border>
                             </Grid>
                         </StackPanel>
                     </Border>
                 </StackPanel>
             </Border>

             <!-- 3. UNIFIED SINGLE & BATCH ACTIVATION CARD (AUTO-DETECT CONTRACT vs DEMAND ID) -->
             <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                 <StackPanel>
                     <TextBlock Text="3. Exécution Unitaire ou Batch Excel (Détection automatique Contrat / Demand ID)"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,4" />
                     <TextBlock Text="Insérez directement un numéro ci-dessous (Contrat 12 chiffres / 3-7-2 ou Demand ID ELIA) pour une activation unitaire, ou sélectionnez un fichier Excel / CSV juste en dessous pour un lancement en Batch. Cliquez sur une ligne du tableau en bas pour afficher la synthèse complète d'Autocomplete SQL."
                                FontSize="11.5"
                                Foreground="{StaticResource TextSecondary}"
                                Margin="0,0,0,12"
                                TextWrapping="Wrap" />

                     <!-- LIGNE 1 : ACTIVATION UNITAIRE -->
                     <Border Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="14,10"
                             Margin="0,0,0,12">
                         <StackPanel>
                             <Grid Margin="0,0,0,6">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Grid.Column="0"
                                            Text="⚡ Activation Unitaire — Numéro de Contrat (ex: 582-2437921-78) ou Demand ID ELIA (ex: 100458921) :"
                                            FontWeight="Bold"
                                            FontSize="12.5"
                                            Foreground="#0F172A"
                                            VerticalAlignment="Center" />
                                 <Border Grid.Column="1"
                                         Background="#EFF6FF"
                                         BorderBrush="#BFDBFE"
                                         BorderThickness="1"
                                         CornerRadius="5"
                                         Padding="8,2">
                                     <TextBlock x:Name="TxtActDetectedTypeBadge"
                                                Text="Auto-détection : Contrat (12 chiffres / 3-7-2) ou Demand ID"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#1D4ED8" />
                                 </Border>
                             </Grid>

                             <Grid>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                 <TextBox x:Name="TxtActContract"
                                          Grid.Column="0"
                                          Style="{StaticResource InputTextBoxStyle}"
                                          Margin="0,0,10,0"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          TextChanged="TxtActContract_TextChanged"
                                          KeyDown="TxtActContract_KeyDown"
                                          ToolTip="Saisissez un Numéro de Contrat (12 chiffres ou 3-7-2) ou un Demand ID ELIA (6 à 10 chiffres). Appuyez sur Entrée pour lancer l'activation unitaire." />
                                 <Button x:Name="BtnRunSingleAct"
                                         Grid.Column="1"
                                         Content="🚀 Run Single"
                                         Click="BtnRunSingleActivation_Click"
                                         Style="{DynamicResource ActionButtonStyle}"
                                         Width="165"
                                         Margin="0,0,8,0" />
                                 <Button x:Name="BtnSkipPrimeSingleAct"
                                         Grid.Column="2"
                                         Content="⏭️ Skip Prime"
                                         Click="BtnSkipPrimeSingleAct_Click"
                                         Style="{DynamicResource ActionButtonStyle}"
                                         Background="#F59E0B"
                                         Width="140"
                                         Margin="0,0,8,0" />
                                 <Button x:Name="BtnCancelSingleAct"
                                         Grid.Column="3"
                                         Content="🛑 Cancel"
                                         Click="BtnCancelActivation_Click"
                                         Style="{DynamicResource CancelButtonStyle}"
                                         Width="110"
                                         IsEnabled="False" />
                             </Grid>
                         </StackPanel>
                     </Border>

                     <!-- LIGNE 2 : ACTIVATION BATCH (EXCEL / CSV) -->
                     <Border Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="14,10">
                         <StackPanel>
                             <Grid Margin="0,0,0,6">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Grid.Column="0"
                                            Text="📁 Activation Batch par Fichier Excel / CSV (Détection auto Contrat / Demand ID par ligne &amp; N° de ligne Excel exact) :"
                                            FontWeight="Bold"
                                            FontSize="12.5"
                                            Foreground="#0F172A"
                                            VerticalAlignment="Center" />
                                 <TextBlock Grid.Column="1"
                                            Text="Colonnes optionnelles : BR23, AMOUNT, RUNDATE, BUCP, CMDPMT, PROCESS, FUNDS"
                                            FontSize="11"
                                            Foreground="#64748B"
                                            VerticalAlignment="Center" />
                             </Grid>

                             <Grid Margin="0,0,0,10">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                 <TextBox x:Name="TxtBatchActCsv"
                                          Grid.Column="0"
                                          IsReadOnly="True"
                                          Style="{StaticResource InputTextBoxStyle}"
                                          Background="White"
                                          Margin="0,0,8,0"
                                          ToolTip="Chemin du fichier Excel (.xlsx/.xls) ou CSV de batch." />
                                 <Button x:Name="BtnUseDefaultQcActFile"
                                         Grid.Column="1"
                                         Content="📋 Default QC Excel"
                                         Padding="10,8"
                                         Margin="0,0,6,0"
                                         Background="#0F766E"
                                         Foreground="White"
                                         FontWeight="Bold"
                                         BorderThickness="0"
                                         Cursor="Hand"
                                         ToolTip="Charger automatiquement le fichier Excel QC par défaut selon l'Environnement et le Process."
                                         Click="BtnUseDefaultQcActFile_Click" />
                                 <Button Grid.Column="2"
                                         Content="📂 Browse..."
                                         Padding="12,8"
                                         Margin="0,0,6,0"
                                         Background="#334155"
                                         Foreground="White"
                                         FontWeight="Bold"
                                         BorderThickness="0"
                                         Cursor="Hand"
                                         Click="BtnBrowseActCsv_Click" />
                                 <Button x:Name="BtnPreviewBatchActFile"
                                         Grid.Column="3"
                                         Content="🔍 Preview"
                                         Padding="12,8"
                                         Margin="0,0,8,0"
                                         Background="#2563EB"
                                         Foreground="White"
                                         FontWeight="Bold"
                                         BorderThickness="0"
                                         Cursor="Hand"
                                         ToolTip="Inspecter les lignes et numéros de lignes Excel du fichier avant lancement."
                                         Click="BtnPreviewBatchFile_Click" />
                                 <Button x:Name="BtnRunBatchAct"
                                         Grid.Column="4"
                                         Content="🚀 Run Batch"
                                         Click="BtnRunBatchActivation_Click"
                                         Style="{DynamicResource ActionButtonStyle}"
                                         Width="150"
                                         Margin="0,0,8,0" />
                                 <Button x:Name="BtnSkipPrimeBatchAct"
                                         Grid.Column="5"
                                         Content="⏭️ Skip Prime"
                                         Click="BtnSkipPrimeBatchAct_Click"
                                         Style="{DynamicResource ActionButtonStyle}"
                                         Background="#F59E0B"
                                         Width="135"
                                         Margin="0,0,8,0" />
                                 <Button x:Name="BtnCancelBatchAct"
                                         Grid.Column="6"
                                         Content="🛑 Cancel"
                                         Click="BtnCancelActivation_Click"
                                         Style="{DynamicResource CancelButtonStyle}"
                                         Width="105"
                                         IsEnabled="False" />
                             </Grid>

                             <!-- BARRE DE PROGRESSION UNIFIÉE (UNITAIRE & BATCH) -->
                             <Border Background="#EFF6FF"
                                     BorderBrush="#BFDBFE"
                                     BorderThickness="1.5"
                                     CornerRadius="8"
                                     Padding="14,10">
                                 <Grid>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                     </Grid.RowDefinitions>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                     <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                         <Border Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="7,1" Margin="0,0,10,0">
                                             <TextBlock x:Name="TxtBatchProgressMode" Text="PRÊT (UNITAIRE / BATCH)" FontWeight="Bold" Foreground="#1E40AF" FontSize="11" />
                                         </Border>
                                         <TextBlock Text="Progression : " FontWeight="Bold" Foreground="#1E3A8A" FontSize="12" VerticalAlignment="Center" />
                                         <TextBlock x:Name="TxtBatchProcessedCount" Text="0" FontWeight="Bold" Foreground="#047857" FontSize="12.5" VerticalAlignment="Center" />
                                         <TextBlock Text=" / " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                         <TextBlock x:Name="TxtBatchPlannedCount" Text="0" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5" VerticalAlignment="Center" />
                                         <TextBlock Text="   Restant : " Margin="10,0,0,0" Foreground="#475569" FontSize="12" VerticalAlignment="Center" />
                                         <TextBlock x:Name="TxtBatchRemainingCount" Text="0" FontWeight="Bold" Foreground="#D97706" FontSize="12" VerticalAlignment="Center" />
                                         <TextBlock x:Name="TxtBatchElapsedTime" Text="   ⏱️ 0.0s" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#334155" FontSize="12" VerticalAlignment="Center" />
                                     </WrapPanel>
                                     <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                         <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,1" Margin="0,0,10,0">
                                             <TextBlock x:Name="TxtBatchProgressStatus" Text="READY" FontWeight="Bold" Foreground="#64748B" FontSize="11.5" />
                                         </Border>
                                         <TextBlock x:Name="TxtBatchProgressPercentage" Text="0%" FontWeight="Bold" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center" />
                                     </StackPanel>
                                     <TextBlock Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,5,0,2"
                                                FontSize="11.5"
                                                TextTrimming="CharacterEllipsis">
                                         <Run Text="En cours : " Foreground="#475569" FontWeight="SemiBold" />
                                         <Run x:Name="TxtBatchCurrentContract" Text="-" Foreground="#1D4ED8" FontWeight="Bold" />
                                     </TextBlock>
                                     <ProgressBar x:Name="ProgressBatchActivation"
                                                  Grid.Row="2"
                                                  Grid.ColumnSpan="2"
                                                  Height="9"
                                                  Margin="0,4,0,0"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Value="0"
                                                  Foreground="#2563EB"
                                                  Background="#DBEAFE" />
                                 </Grid>
                             </Border>
                         </StackPanel>
                     </Border>
                 </StackPanel>
             </Border>

             <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="18,16">
                 <Grid>
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                     </Grid.RowDefinitions>
                     <Grid Grid.Row="0" Margin="0,0,0,12">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                         </Grid.ColumnDefinitions>
                         <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                             <TextBlock Text="Live Activation &amp; Diagnostic Monitor"
                                        FontSize="15.5"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextPrimary}"
                                        Margin="0,0,16,0" />
                             <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,2,8,2">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="Total: " FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                                     <TextBlock x:Name="TxtActTotalCount" Text="0" FontSize="12" FontWeight="Bold" />
                                 </StackPanel>
                             </Border>
                             <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,2,8,2">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="Activated: " FontSize="12" FontWeight="SemiBold" Foreground="#047857" />
                                     <TextBlock x:Name="TxtActSuccessCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#047857" />
                                 </StackPanel>
                             </Border>
                             <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,2,8,2">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="Branche 21: " FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                     <TextBlock x:Name="TxtActBranch21Count" Text="0" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" />
                                 </StackPanel>
                             </Border>
                             <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,2,8,2">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="Branche 23: " FontSize="12" FontWeight="SemiBold" Foreground="#6D28D9" />
                                     <TextBlock x:Name="TxtActBranch23Count" Text="0" FontSize="12" FontWeight="Bold" Foreground="#6D28D9" />
                                 </StackPanel>
                             </Border>
                             <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,2,8,2">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="Already / Pending: " FontSize="12" FontWeight="SemiBold" Foreground="#B45309" />
                                     <TextBlock x:Name="TxtActAlreadyCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#B45309" />
                                 </StackPanel>
                             </Border>
                             <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,2,8,2">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="Failed / Cancelled: " FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" />
                                     <TextBlock x:Name="TxtActFailCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" />
                                 </StackPanel>
                             </Border>
                         </WrapPanel>
                         <StackPanel Grid.Column="1" Orientation="Horizontal">
                             <Button x:Name="BtnInspectSelectedAct"
                                     Content="🔍 Inspect Report"
                                     Click="BtnInspectSelectedAct_Click"
                                     Cursor="Hand"
                                     Padding="10,5"
                                     Margin="0,0,6,0"
                                     FontWeight="Bold"
                                     Background="#0F172A"
                                     Foreground="White"
                                     BorderThickness="0"
                                     ToolTip="Open full SQL &amp; Mainframe JES2 diagnostic report for the selected row" />
                             <Button x:Name="BtnRetrySelectedAct"
                                     Content="🔄 Load in Single Input"
                                     Click="BtnRetrySelectedAct_Click"
                                     Cursor="Hand"
                                     Padding="10,5"
                                     Margin="0,0,6,0"
                                     FontWeight="Bold"
                                     Background="#F5F3FF"
                                     Foreground="#6D28D9"
                                     BorderBrush="#DDD6FE"
                                     BorderThickness="1"
                                     ToolTip="Load the selected contract/demand into the Single Contract Activation input line to replay or run specific steps" />
                             <Button x:Name="BtnSendSelectedToExt"
                                     Content="📥 Extract SQL"
                                     Click="BtnSendSelectedToExt_Click"
                                     Cursor="Hand"
                                     Padding="10,5"
                                     Margin="0,0,6,0"
                                     FontWeight="Bold"
                                     Background="#ECFDF5"
                                     Foreground="#047857"
                                     BorderBrush="#A7F3D0"
                                     BorderThickness="1"
                                     ToolTip="Send the selected contract directly to the SQL Data Extraction view" />
                             <Button x:Name="BtnExportActHistoryCsv"
                                     Content="📥 Export CSV"
                                     Click="BtnExportActHistoryCsv_Click"
                                     Cursor="Hand"
                                     Padding="10,5"
                                     Margin="0,0,6,0"
                                     FontWeight="Bold"
                                     Background="#EFF6FF"
                                     Foreground="#2563EB"
                                     BorderBrush="#BFDBFE"
                                     BorderThickness="1" />
                             <Button x:Name="BtnClearActHistory"
                                     Content="🗑️ Clear Log"
                                     Click="BtnClearActHistory_Click"
                                     Cursor="Hand"
                                     Padding="10,5"
                                     FontWeight="Bold"
                                     Background="White"
                                     Foreground="{StaticResource DangerRed}"
                                     BorderBrush="{StaticResource DangerRed}"
                                     BorderThickness="1" />
                         </StackPanel>
                     </Grid>

                     <!-- LIVE SEARCH & FILTER BAR -->
                     <Border Grid.Row="1"
                             Background="#F8FAFC"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="10,8"
                             Margin="0,0,0,10">
                         <Grid>
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="12" />
                                 <ColumnDefinition Width="165" />
                                 <ColumnDefinition Width="12" />
                                 <ColumnDefinition Width="155" />
                             </Grid.ColumnDefinitions>
                             <TextBlock Grid.Column="0"
                                        Text="🔍 Filter:"
                                        FontWeight="Bold"
                                        Foreground="#334155"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                             <TextBox x:Name="TxtFilterActHistory"
                                      Grid.Column="1"
                                      Padding="8,5"
                                      FontSize="12.5"
                                      BorderBrush="#CBD5E1"
                                      ToolTip="Filter by Contract ID, Demand ID, Product, LISA ID, Excel Row or Canal"
                                      TextChanged="FilterActHistory_Changed" />
                             <ComboBox x:Name="CmbFilterActBranch"
                                       Grid.Column="3"
                                       Padding="8,5"
                                       FontSize="12.5"
                                       SelectedIndex="0"
                                       SelectionChanged="FilterActHistory_Changed">
                                 <ComboBoxItem Content="All Branches" Tag="ALL" />
                                 <ComboBoxItem Content="Branche 21" Tag="Branche 21" />
                                 <ComboBoxItem Content="Branche 23" Tag="Branche 23" />
                             </ComboBox>
                             <ComboBox x:Name="CmbFilterActStatus"
                                       Grid.Column="5"
                                       Padding="8,5"
                                       FontSize="12.5"
                                       SelectedIndex="0"
                                       SelectionChanged="FilterActHistory_Changed">
                                 <ComboBoxItem Content="All Statuses" Tag="ALL" />
                                 <ComboBoxItem Content="SUCCESS" Tag="SUCCESS" />
                                 <ComboBoxItem Content="ALREADY ACTIVE" Tag="ALREADY" />
                                 <ComboBoxItem Content="FAILED / CANCELLED" Tag="FAILED" />
                             </ComboBox>
                         </Grid>
                     </Border>

                     <TextBlock Grid.Row="2"
                                Text="💡 Double-click any row for full SQL &amp; Mainframe spool diagnostics, or right-click to copy IDs or send the contract directly to SQL Data Extraction."
                                FontSize="11.5"
                                Foreground="{StaticResource TextSecondary}"
                                Margin="0,0,0,8"
                                TextWrapping="Wrap" />

                     <ListView x:Name="ListActivationHistory"
                               Grid.Row="3"
                               Background="White"
                               BorderBrush="{StaticResource BorderDefault}"
                               BorderThickness="1"
                               AlternationCount="2"
                               MinHeight="210"
                               MaxHeight="460"
                               MouseDoubleClick="ListActivationHistory_MouseDoubleClick"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto"
                               ScrollViewer.CanContentScroll="True">
                         <ListView.ContextMenu>
                             <ContextMenu>
                                 <MenuItem Header="🔍 Open Full Diagnostic Report" Click="MenuActOpenReport_Click" FontWeight="Bold" />
                                 <MenuItem Header="🔄 Load into Single Activation Input" Click="BtnRetrySelectedAct_Click" FontWeight="SemiBold" />
                                 <Separator />
                                 <MenuItem Header="📋 Copy Contract ID" Click="MenuActCopyContract_Click" />
                                 <MenuItem Header="📋 Copy Input / Demand ID" Click="MenuActCopyDemand_Click" />
                                 <Separator />
                                 <MenuItem Header="📥 Send to SQL Data Extraction" Click="MenuActSendToExtraction_Click" />
                             </ContextMenu>
                         </ListView.ContextMenu>
                         <ListView.ItemContainerStyle>
                             <Style TargetType="ListViewItem">
                                 <Setter Property="Padding" Value="4" />
                                 <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                 <Style.Triggers>
                                     <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                         <Setter Property="Background" Value="#F8FAFC" />
                                     </Trigger>
                                     <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                         <Setter Property="Background" Value="#FEF2F2" />
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding Status}" Value="CANCELLED">
                                         <Setter Property="Background" Value="#FFF7ED" />
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding Status}" Value="PENDING ASYNC LISA CREATION">
                                         <Setter Property="Background" Value="#FFFBEB" />
                                     </DataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </ListView.ItemContainerStyle>
                         <ListView.View>
                             <GridView AllowsColumnReorder="True">
                                 <GridViewColumn Header="Excel Row" Width="74">
                                     <GridViewColumn.CellTemplate>
                                         <DataTemplate>
                                             <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Center">
                                                 <TextBlock Text="{Binding RowNum}" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5" HorizontalAlignment="Center" />
                                             </Border>
                                         </DataTemplate>
                                     </GridViewColumn.CellTemplate>
                                 </GridViewColumn>
                                 <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="65" />
                                 <GridViewColumn Header="Env" DisplayMemberBinding="{Binding Env}" Width="54" />
                                 <GridViewColumn Header="Demand ID" DisplayMemberBinding="{Binding DemandId}" Width="105" />
                                 <GridViewColumn Header="Contract ID" Width="128">
                                     <GridViewColumn.CellTemplate>
                                         <DataTemplate>
                                             <TextBlock Text="{Binding ContractId}" FontWeight="Bold" Foreground="#0F172A" />
                                         </DataTemplate>
                                     </GridViewColumn.CellTemplate>
                                 </GridViewColumn>
                                 <GridViewColumn Header="JCL ID" DisplayMemberBinding="{Binding JclContract}" Width="84" />
                                 <GridViewColumn Header="LISA ID" DisplayMemberBinding="{Binding LisaId}" Width="84" />
                                 <GridViewColumn Header="UCON ID" DisplayMemberBinding="{Binding UconId}" Width="88" />
                                 <GridViewColumn Header="Branche" Width="98">
                                     <GridViewColumn.CellTemplate>
                                         <DataTemplate>
                                             <Border x:Name="BranchBadge" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                                 <TextBlock x:Name="BranchText" Text="{Binding BranchDisplay}" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                                             </Border>
                                             <DataTemplate.Triggers>
                                                 <DataTrigger Binding="{Binding IsBranch23}" Value="True">
                                                     <Setter TargetName="BranchBadge" Property="Background" Value="#F5F3FF" />
                                                     <Setter TargetName="BranchBadge" Property="BorderBrush" Value="#DDD6FE" />
                                                     <Setter TargetName="BranchText" Property="Foreground" Value="#6D28D9" />
                                                 </DataTrigger>
                                             </DataTemplate.Triggers>
                                         </DataTemplate>
                                     </GridViewColumn.CellTemplate>
                                 </GridViewColumn>
                                 <GridViewColumn Header="Product" DisplayMemberBinding="{Binding ProductCode}" Width="68" />
                                 <GridViewColumn Header="Process" DisplayMemberBinding="{Binding ProcessCode}" Width="60" />
                                 <GridViewColumn Header="Ch" DisplayMemberBinding="{Binding ChannelCode}" Width="42" />
                                 <GridViewColumn Header="Canal" Width="118">
                                     <GridViewColumn.CellTemplate>
                                         <DataTemplate>
                                             <TextBlock x:Name="BusinessChannelText"
                                                        Text="{Binding BusinessChannel}"
                                                        FontWeight="Bold"
                                                        Foreground="#64748B" />
                                             <DataTemplate.Triggers>
                                                 <DataTrigger Binding="{Binding BusinessChannel}" Value="BANK">
                                                     <Setter TargetName="BusinessChannelText" Property="Foreground" Value="#2563EB" />
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding BusinessChannel}" Value="BROKER_NEW_GEN">
                                                     <Setter TargetName="BusinessChannelText" Property="Foreground" Value="#7C3AED" />
                                                 </DataTrigger>
                                             </DataTemplate.Triggers>
                                         </DataTemplate>
                                     </GridViewColumn.CellTemplate>
                                 </GridViewColumn>
                                 <GridViewColumn Header="BUCP" DisplayMemberBinding="{Binding Bucp}" Width="62" />
                                 <GridViewColumn Header="CMD" DisplayMemberBinding="{Binding Cmdpmt}" Width="48" />
                                 <GridViewColumn Header="Prime" DisplayMemberBinding="{Binding Premium}" Width="86" />
                                 <GridViewColumn Header="Fonds / VNI / Mvt" DisplayMemberBinding="{Binding FundsSummary}" Width="145" />
                                 <GridViewColumn Header="Run Date" DisplayMemberBinding="{Binding RunDate}" Width="80" />
                                 <GridViewColumn Header="JCL Steps &amp; RC" DisplayMemberBinding="{Binding StepsInfo}" Width="175" />
                                 <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="66" />
                                 <GridViewColumn Header="Status" Width="168">
                                     <GridViewColumn.CellTemplate>
                                         <DataTemplate>
                                             <TextBlock x:Name="ActivationRowStatus" Text="{Binding Status}" FontWeight="Bold" Foreground="#64748B" />
                                             <DataTemplate.Triggers>
                                                 <DataTrigger Binding="{Binding Status}" Value="SUCCESS">
                                                     <Setter TargetName="ActivationRowStatus" Property="Foreground" Value="#059669" />
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding Status}" Value="ALREADY ACTIVE">
                                                     <Setter TargetName="ActivationRowStatus" Property="Foreground" Value="#D97706" />
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding Status}" Value="PENDING ASYNC LISA CREATION">
                                                     <Setter TargetName="ActivationRowStatus" Property="Foreground" Value="#D97706" />
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                     <Setter TargetName="ActivationRowStatus" Property="Foreground" Value="#DC2626" />
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding Status}" Value="CANCELLED">
                                                     <Setter TargetName="ActivationRowStatus" Property="Foreground" Value="#EA580C" />
                                                 </DataTrigger>
                                             </DataTemplate.Triggers>
                                         </DataTemplate>
                                     </GridViewColumn.CellTemplate>
                                 </GridViewColumn>
                                 <GridViewColumn Header="Routing rule" DisplayMemberBinding="{Binding RoutingRule}" Width="220" />
                                 <GridViewColumn Header="Timeline and diagnostics" Width="340">
                                     <GridViewColumn.CellTemplate>
                                         <DataTemplate>
                                             <TextBlock Text="{Binding DiagnosticSummary}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="#334155"
                                                        ToolTip="{Binding DiagnosticSummary}" />
                                         </DataTemplate>
                                     </GridViewColumn.CellTemplate>
                                 </GridViewColumn>
                             </GridView>
                         </ListView.View>
                     </ListView>
                 </Grid>
             </Border>
         </Grid>
     </ScrollViewer>
 </UserControl>
