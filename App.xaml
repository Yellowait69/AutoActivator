<Application x:Class="AutoActivator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#1D4ED8" />
        <SolidColorBrush x:Key="TextMain" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="BgLight" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#059669" />
        <SolidColorBrush x:Key="WarningAmber" Color="#D97706" />
        <SolidColorBrush x:Key="DangerRed" Color="#DC2626" />
    </Application.Resources>

</Application>