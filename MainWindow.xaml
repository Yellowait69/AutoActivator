<Window x:Class="AutoActivator.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoActivator.Gui.Views"
        Title="AutoActivator — LISA &amp; ELIA E.T.L Suite" Height="860" Width="1240" MinHeight="700" MinWidth="1020"
        Background="#F1F5F9" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Resources>

        <!-- Primary Action Button (Corporate Slate Blue) -->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel / Stop Button (Sober neutral at rest, crisp red outline when enabled) -->
        <Style TargetType="Button" x:Key="CancelButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button -->
        <Style TargetType="Button" x:Key="MenuButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="14,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MODERN DARK SLATE SIDEBAR -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,26,20,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
                            <TextBlock Text="AA" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AUTO-ACTIVATOR" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="LISA &amp; ELIA SUITE" Foreground="#94A3B8" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MODULES" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="24,0,0,8"/>

                    <Button x:Name="BtnActivation" Content="Activation Contrats" Style="{StaticResource MenuButtonStyle}" Background="#2563EB" Foreground="White" Click="BtnMenu_Click"/>
                    <Button x:Name="BtnExtraction" Content="Extraction SQL" Style="{StaticResource MenuButtonStyle}" Click="BtnMenu_Click"/>
                    <Button x:Name="BtnComparison" Content="Comparaison" Style="{StaticResource MenuButtonStyle}" Click="BtnMenu_Click"/>

                    <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Margin="20,18,20,18"/>

                    <TextBlock Text="DOCUMENTATION" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="24,0,0,8"/>
                    <Button x:Name="BtnHelp" Content="Aide &amp; Référentiel" Style="{StaticResource MenuButtonStyle}" Click="BtnMenu_Click"/>

                    <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Margin="20,18,20,18"/>

                    <TextBlock Text="DOSSIERS" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="24,0,0,8"/>
                    <Button x:Name="BtnSidebarOutput" Content="Dossier Rapports (Output)" Style="{StaticResource MenuButtonStyle}" Click="BtnSidebarOutput_Click"/>
                    <Button x:Name="BtnSidebarBaselines" Content="Dossier Baselines" Style="{StaticResource MenuButtonStyle}" Click="BtnSidebarBaselines_Click"/>
                </StackPanel>

                <!-- Connected Session Card in Sidebar Footer -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Margin="14,10,14,18" Padding="14,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtSidebarUser" Text="Session Active" Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtSidebarServer" Text="Mainframe ESCWA Ready" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Column="1" Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- MODULE VIEWS -->
            <views:ActivationView x:Name="ViewActivation" Grid.Row="0" Visibility="Visible"/>
            <views:ExtractionView x:Name="ViewExtraction" Grid.Row="0" Visibility="Collapsed"/>
            <views:ComparisonView x:Name="ViewComparison" Grid.Row="0" Visibility="Collapsed"/>
            <views:HelpView x:Name="ViewHelp" Grid.Row="0" Visibility="Collapsed"/>

            <!-- BARRE D'ÉTAT GLOBALE & ACCÈS DIRECT AU DERNIER RAPPORT / FICHIER GÉNÉRÉ -->
            <Border Grid.Row="1"
                    Visibility="Visible"
                    Background="White"
                    CornerRadius="8"
                    Padding="14,9"
                    Margin="0,12,0,0"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDotEllipse"
                                 Width="7"
                                 Height="7"
                                 Fill="#2563EB"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatusDot"
                                   Text=""
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtStatus"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#1E293B"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="Prêt."/>
                    </StackPanel>

                    <StackPanel x:Name="PanelOutputFileActions"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Button x:Name="BtnOpenGeneratedFile"
                                Click="BtnOpenGeneratedFile_Click"
                                Background="White"
                                Foreground="#1E293B"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Ouvrir directement le fichier rapport / CSV généré">
                            <TextBlock x:Name="TxtOpenGeneratedFileLabel" Text="Ouvrir le rapport"/>
                        </Button>
                        <Button x:Name="BtnRevealGeneratedFolder"
                                Content="Dossier"
                                Click="Hyperlink_Click"
                                Background="#F8FAFC"
                                Foreground="#334155"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Padding="10,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Afficher et sélectionner le fichier généré dans l'Explorateur Windows"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>